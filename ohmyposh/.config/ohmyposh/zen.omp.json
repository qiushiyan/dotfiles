    "template": "{{ if .Env.TERMINAL_THEME }}{{ .Env.TERMINAL_THEME }}{{ else }}gruber_darker{{ end }}",
    "list": {
      "gruber_darker": {
        "os": "#808080",
        "closer": "p:os",
        "pink": "#9e95c7",
        "lavender": "#e4e4ef",
        "blue": "#e3bf33",
        "green": "#ffdd33",
        "peach": "#cc8c3c",
        "red": "#f43841"
      },
      "catppuccin_mocha": {
        "os": "#ACB0BE",
        "closer": "p:os",
        "pink": "#F5C2E7",
        "lavender": "#B4BEFE",
        "blue":  "#89B4FA",
        "green": "#A6E3A1",
        "peach": "#FAB387",
        "red": "#F38BA8"
      },
      "tailwind_light": {
        "os": "#62748e",
        "closer": "p:os",
        "pink": "#9810fa",
        "lavender": "#9810fa",
        "blue":  "#1447e6",
        "green": "#009966",
        "peach": "#e17100",
        "red": "#c70036"
      },
      "tokyo_night_moon": {
        "os": "#828bb8",
        "closer": "p:os",
        "pink": "#fca7ea",
        "lavender": "#c8d3f5",
        "blue":  "#86e1fc",
        "green": "#c3e88d",
        "peach": "#ff966c",
        "red": "#ff757f"
      },
      "gruvbox_dark": {
        "os": "#928374",
        "closer": "p:os",
        "pink": "#d3869b",
        "lavender": "#ebdbb2",
        "blue":  "#8ec07c",
        "green": "#b8bb26",
        "peach": "#fe8019",
        "red": "#fb4934"
      },
      "vitesse_light_soft": {
        "os": "#999999",
        "closer": "p:os",
        "pink": "#a13865",
        "lavender": "#a13865",
        "blue":  "#296aa3",
        "green": "#1e754f",
        "peach": "#a65e2b",
        "red": "#ab5959"
      },
      "night_owl": {
        "os": "#5f7e97",
        "closer": "p:os",
        "pink": "#c792ea",
        "lavender": "#d6deeb",
        "blue": "#7fdbca",
        "green": "#addb67",
        "peach": "#f78c6c",
        "red": "#ef5350"
      },
      "orng_light": {
        "os": "#8a8a8a",
        "closer": "p:os",
        "pink": "#c94d24",
        "lavender": "#c94d24",
        "blue": "#318795",
        "green": "#317b46",
        "peach": "#EC5B2B",
        "red": "#d1383d"
      },
      "forest_night": {
        "os": "#6b7280",
        "closer": "p:os",
        "pink": "#9B59B6",
        "lavender": "#c9d1d9",
        "blue": "#4ECDC4",
        "green": "#8FBC8F",
        "peach": "#E67E22",
        "red": "#E91E63"
      },
      "waffle_cat": {
        "os": "#a58c82",
        "closer": "p:os",
        "pink": "#c98c97",
        "lavender": "#fff4d8",
        "blue": "#c87d2a",
        "green": "#e4c56d",
        "peach": "#df9850",
        "red": "#cf7358"
      },
      "vellum": {
        "os": "#737373",
        "closer": "p:os",
        "pink": "#9a6a18",
        "lavender": "#9a6a18",
        "blue": "#1447e6",
        "green": "#008236",
        "peach": "#bb4d00",
        "red": "#c10007"
      },
      "token_meridian_light": {
        "os": "#524b42",
        "closer": "p:os",
        "pink": "#7a1f7a",
        "lavender": "#7a1f7a",
        "blue": "#0048b3",
        "green": "#005f2f",
        "peach": "#843900",
        "red": "#286fc0"
      }
    }
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "p:blue",
          "options": {
            "home_icon": "~",
            "style": "full"
          },
          "style": "plain",
          "template": "{{ .Path }}",
          "type": "path"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "foreground": "p:lavender",
          "options": {
            "branch_icon": " ",
            "fetch_status": true,
            "untracked_modes": {
              "*": "no"
            }
          },
          "timeout": 300,
          "template": "{{ .HEAD }}{{ if or .Working.Changed .Staging.Changed }} ●{{ end }} ",
          "style": "plain",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "segments": [
        {
          "style": "plain",
          "foreground": "p:green",
          "template": "❯",
          "type": "text"
        }
      ],
      "type": "prompt",
      "newline": true
    }
  ],
  "transient_prompt": {
    "foreground": "p:green",
    "foreground_templates": [
      "{{ if gt .Code 0 }}p:red{{ end }}"
    ],
    "template": "❯ "
  },
  "final_space": true,
  "version": 4
}
