{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "manipulators": [
                            {
                                "description": "Change caps_lock to command+control+option+shift.",
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": {
                                        "optional": [
                                            "any"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "left_shift",
                                        "modifiers": [
                                            "left_command",
                                            "left_control",
                                            "left_option"
                                        ]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Ghostty: ctrl+` toggles windows, opening a second one if needed",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "grave_accent_and_tilde",
                                    "modifiers": {
                                        "mandatory": [
                                            "control"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "grave_accent_and_tilde",
                                        "modifiers": [
                                            "left_control"
                                        ]
                                    },
                                    {
                                        "shell_command": "/usr/bin/osascript ~/.config/ghostty/scripts/second-window.applescript"
                                    }
                                ],
                                "conditions": [
                                    {
                                        "type": "frontmost_application_if",
                                        "bundle_identifiers": [
                                            "^com\\.mitchellh\\.ghostty$"
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "ctrl+space sends f18, the input source shortcut: over Universal Control every modifier release arrives twice, and a shortcut that commits on release then switches twice",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "spacebar",
                                    "modifiers": {
                                        "mandatory": [
                                            "control"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "f18",
                                        "repeat": false
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "Chrome: ctrl+shift+p focuses the address bar, as Arc's command bar did; a macOS App Shortcut on Open Location would take cmd+l away",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "p",
                                    "modifiers": {
                                        "mandatory": [
                                            "control",
                                            "shift"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "l",
                                        "modifiers": [
                                            "left_command"
                                        ]
                                    }
                                ],
                                "conditions": [
                                    {
                                        "type": "frontmost_application_if",
                                        "bundle_identifiers": [
                                            "^com\\.google\\.Chrome$"
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "Chrome: the overrides carried from Arc, ctrl+f finds, ctrl+shift+i opens DevTools, ctrl+shift+r force reloads",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "f",
                                    "modifiers": {
                                        "mandatory": [
                                            "control"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "f",
                                        "modifiers": [
                                            "left_command"
                                        ]
                                    }
