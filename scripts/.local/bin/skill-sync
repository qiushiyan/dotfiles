#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["ruamel.yaml==0.18.16"]
# ///
"""Mirror Claude skill frontmatter into Codex's per-skill invocation policy,
and copy broadcast documents from this repository into other checkouts."""

import argparse
from copy import deepcopy
from dataclasses import dataclass
from io import StringIO
import os
from pathlib import Path
import stat
import sys
import tempfile

from ruamel.yaml import YAML
from ruamel.yaml.comments import CommentedMap, CommentedSeq
from ruamel.yaml.error import YAMLError


FIELD = "allow_implicit_invocation"
MANIFEST = "scripts/.local/share/dotfiles/documents.yaml"


@dataclass
class Change:
    before: bytes | None  # None: the destination does not exist yet
    after: bytes
    external: bool


def yaml_parser():
    parser = YAML()
    parser.preserve_quotes = True
    return parser


def mapping(text, source):
    value = yaml_parser().load(text)
    if not isinstance(value, CommentedMap):
        raise ValueError(f"{source}: expected a YAML mapping")
    return value


def allows_implicit(skill):
    lines = skill.read_text().splitlines(keepends=True)
    if not lines or lines[0].strip() != "---":
        raise ValueError(f"{skill}: missing YAML frontmatter")
    end = next((i for i in range(1, len(lines)) if lines[i].strip() == "---"), None)
    if end is None:
        raise ValueError(f"{skill}: unterminated YAML frontmatter")
    data = mapping("".join(lines[1:end]), skill)
    disabled = data.get("disable-model-invocation", False)
    if type(disabled) is not bool:
        raise ValueError(f"{skill}: disable-model-invocation must be a YAML boolean")
    return not disabled


def render_metadata(before, desired, path):
    data = mapping(before, path) if before.strip() else CommentedMap()
    policy = data.get("policy", CommentedMap())
    if not isinstance(policy, CommentedMap):
        raise ValueError(f"{path}: policy must be a YAML mapping")
    current = policy.get(FIELD, True)
    if type(current) is not bool:
        raise ValueError(f"{path}: policy.{FIELD} must be a YAML boolean")
    if current == desired:
        return before
    # Detach an aliased policy so changing it cannot mutate another section.
    policy = deepcopy(policy)
    data["policy"] = policy
    policy[FIELD] = desired
    if FIELD not in policy.ca.items:
        policy.yaml_add_eol_comment("Derived from SKILL.md by skill-sync", FIELD)
    output = StringIO()
    yaml_parser().dump(data, output)
    return output.getvalue()


def plan_skills(roots, repo):
    changes = {}
    seen = set()
    destinations = {}
    for root in roots:
        root = root.expanduser().resolve(strict=True)
        if not root.is_dir():
            raise ValueError(f"{root}: expected a skill directory")
        for entry in sorted(root.iterdir()):
            if entry.name.startswith("."):
                continue
            if entry.is_symlink() and not entry.exists():
                raise ValueError(f"{entry}: broken symlink")
            skill = entry / "SKILL.md"
            if not skill.exists():
                if skill.is_symlink():
                    raise ValueError(f"{skill}: broken symlink")
                continue
            source = skill.resolve(strict=True)
            # Keep the folder's identity: a linked SKILL.md need not share metadata.
            folder = entry.resolve(strict=True)
            if folder in seen:
                continue
            seen.add(folder)
            desired = allows_implicit(source)
            agents = folder / "agents"
            if agents.is_symlink() and not agents.exists():
                raise ValueError(f"{agents}: broken symlink")
            candidate = folder / "agents" / "openai.yaml"
            if candidate.is_symlink() and not candidate.exists():
                raise ValueError(f"{candidate}: broken symlink")
            path = candidate.resolve()
            if path in destinations and destinations[path] != desired:
                raise ValueError(f"{path}: linked skills request conflicting invocation policies")
            destinations[path] = desired
            before = path.read_bytes() if path.exists() else None
            after = render_metadata(before.decode() if before is not None else "", desired, path)
            if after.encode() != (before or b""):
                changes[path] = Change(before, after.encode(), not path.is_relative_to(repo))
    if not seen:
        raise ValueError("no SKILL.md files found in the selected roots")
    return changes, len(seen), set(destinations)


def relative_inside(value, field, manifest):
    if not isinstance(value, str) or not value.strip():
        raise ValueError(f"{manifest}: {field} must be a non-empty string")
    path = Path(value)
    if path.is_absolute() or ".." in path.parts:
        raise ValueError(f"{manifest}: {field} {value!r} must stay inside its root")
    return path


def checkout_root(value, manifest):
    if not isinstance(value, str) or not value.strip():
        raise ValueError(f"{manifest}: repo must be a non-empty string")
    repo = Path(value).expanduser()
    if not repo.is_absolute():
        raise ValueError(f"{manifest}: repo {value!r} must be an absolute path")
    if not repo.exists():
        return None
    if not repo.is_dir() or not (repo / ".git").exists():
        raise ValueError(f"{repo}: not a checkout root (no .git)")
    return repo.resolve(strict=True)


def plan_documents(manifest, repo, reserved):
    """Plan verbatim copies. `reserved` holds outputs another job already owns."""
    data = mapping(manifest.read_text(), manifest)
    if set(data) != {"documents"} or not isinstance(data["documents"], CommentedSeq):
        raise ValueError(f"{manifest}: expected one top-level key, documents, holding a list")
    sources = {}
    copies = []  # (source, destination) pairs, resolved
    skipped = []
    for item in data["documents"]:
        if not isinstance(item, CommentedMap) or set(item) != {"source", "destinations"}:
            raise ValueError(f"{manifest}: each document has exactly source and destinations")
        source = repo / relative_inside(item["source"], "source", manifest)
        if not source.is_file():
            raise ValueError(f"{source}: source is not a file")
        source = source.resolve(strict=True)
        if not source.is_relative_to(repo):
            raise ValueError(f"{source}: source resolves outside {repo}")
        if source in sources:
            raise ValueError(f"{source}: declared as a source more than once")
        sources[source] = source.read_bytes()
        destinations = item["destinations"]
        if not isinstance(destinations, CommentedSeq) or not destinations:
            raise ValueError(f"{manifest}: {item['source']} needs a non-empty destinations list")
        for destination in destinations:
            if not isinstance(destination, CommentedMap) or set(destination) != {"repo", "path"}:
                raise ValueError(f"{manifest}: each destination has exactly repo and path")
            root = checkout_root(destination["repo"], manifest)
            relative = relative_inside(destination["path"], "path", manifest)
            if root is None:
                skipped.append(Path(destination["repo"]).expanduser())
                continue
            target = root / relative
            if target.is_symlink():
                raise ValueError(f"{target}: destination is a symlink")
            if target.exists() and not target.is_file():
                raise ValueError(f"{target}: destination is not a file")
            resolved = target.parent.resolve() / target.name
            if not resolved.is_relative_to(root):
                raise ValueError(f"{target}: destination resolves outside {root}")
            copies.append((source, resolved))
    if not sources:
        raise ValueError(f"{manifest}: no documents listed")
    # Every source and output is known before any write is planned, so a copy
    # can neither feed another copy nor overwrite a file another job owns.
    outputs = set(reserved)
    for source, resolved in copies:
        if resolved in sources or resolved in reserved:
            raise ValueError(f"{resolved}: a destination may not be a source or a metadata file")
        if resolved in outputs:
            raise ValueError(f"{resolved}: written by more than one sync job")
        outputs.add(resolved)
    for source in sources:
        if source in reserved:
            raise ValueError(f"{source}: a metadata file may not be a source")
    changes = {}
    for source, resolved in copies:
        before = resolved.read_bytes() if resolved.exists() else None
        if before != sources[source]:
            changes[resolved] = Change(before, sources[source], not resolved.is_relative_to(repo))
    return changes, len(sources), skipped


def write_atomic(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o644
    fd, temporary = tempfile.mkstemp(prefix=".skill-sync-", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as output:
            output.write(content)
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main():
    parser = argparse.ArgumentParser(description=__doc__, epilog=(
        "Requires uv (dependencies are cached). Exit: 0 synchronized, "
        "1 drift with --check, 2 invalid input or write failure. With no scope "
        "flag both jobs run on this repository's skill trees and document manifest; "
        "a scope flag runs only the jobs it names. Destinations outside this "
        "repository are reported for review and commit there."
    ))
    parser.add_argument("--check", action="store_true", help="report drift without writing")
    parser.add_argument("--skills-dir", action="append", type=Path, help=(
        "scan immediate skill folders here; repeat for multiple roots. "
        "Defaults to dotfiles' personal and repository-local Claude skill trees."
    ))
    parser.add_argument("--documents", type=Path, metavar="MANIFEST", help=(
        "copy the documents this manifest lists into their checkouts. "
        f"Defaults to {MANIFEST} in dotfiles."
    ))
    args = parser.parse_args()
    repo = Path(__file__).resolve().parents[3]
    scoped = args.skills_dir is not None or args.documents is not None
    roots = args.skills_dir or ([] if scoped else [repo / "claude/.claude/skills", repo / ".claude/skills"])
    manifest = args.documents or (None if scoped else repo / MANIFEST)
    try:
        # Validate every job before writing anything from either.
        changes = {}
        summaries = []
        outputs = set()
        if roots:
            skill_changes, count, outputs = plan_skills(roots, repo)
            changes.update(skill_changes)
            summaries.append((count, "skills checked", len(skill_changes), "metadata files"))
        if manifest is not None:
            doc_changes, count, skipped = plan_documents(manifest.expanduser().resolve(strict=True), repo, outputs)
            changes.update(doc_changes)
            for root in skipped:
                print(f"skipped {root}: checkout absent")
            summaries.append((count, "documents checked", len(doc_changes), "copies"))
        for path, change in changes.items():
            if not args.check:
                current = path.read_bytes() if path.exists() else None
                if current != change.before:
                    raise ValueError(f"{path}: changed during scan; rerun skill-sync")
                write_atomic(path, change.after)
            verb = "would update" if args.check else "updated"
            print(f"{verb} {path}" + (" [external: review/commit in owning repository]" if change.external else ""))
        status = "need synchronization" if args.check else "updated"
        for count, checked, changed, noun in summaries:
            print(f"{count} {checked}; {changed} {noun} {status}.")
        return 1 if args.check and changes else 0
    except (OSError, ValueError, YAMLError) as error:
        print(f"skill-sync: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
