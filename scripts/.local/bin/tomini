#!/usr/bin/env bash
# tomini — send this machine's clipboard, text or image, to the office mini's
# pasteboard, or another machine's named by MINI_HOST. Claude Code there then
# pastes it with Ctrl+V. An image also stays there as a file (path printed;
# kept 7 days) for tools that take a path. Rex's ctrl+v runs this for a pane on
# another host (rexkit.host). See docs/qiushi-mini.md § Clipboard and attach.
set -euo pipefail

HOST=${MINI_HOST:-qiushi-mini}
PB="$HOME/dotfiles/scripts/.local/share/dotfiles/pasteboard"
PB_MINI='~/dotfiles/scripts/.local/share/dotfiles/pasteboard'
# Fail fast on a machine that is down: Rex holds a key press on this.
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=3 "$HOST")

case ${1:-} in -h|--help) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; esac

work=$(mktemp -d "${TMPDIR:-/tmp}/tomini.XXXXXX")
trap 'rm -rf "$work"' EXIT
# The whole payload is read before the far pasteboard is touched, so a
# failed read never clears what is there.
f=$("$PB" get "$work")
size=$(wc -c < "$f" | tr -d ' ')

case $f in
  *.png)
    name=clip-$(date +%Y%m%d-%H%M%S).png
    path=$("${SSH[@]}" "mkdir -p ~/.cache/clip && find ~/.cache/clip -name 'clip-*.png' -mtime +7 -delete
      f=~/.cache/clip/$name && cat > \$f.part && mv \$f.part \$f && $PB_MINI put \$f && echo \$f" < "$f")
    printf 'tomini: image (%s bytes) → %s pasteboard; file: %s\n' "$size" "$HOST" "$path" ;;
  *)
    "${SSH[@]}" "t=\$(mktemp) && cat > \$t && $PB_MINI put \$t; s=\$?; rm -f \$t; exit \$s" < "$f"
    printf 'tomini: text (%s bytes) → %s pasteboard\n' "$size" "$HOST" ;;
esac
