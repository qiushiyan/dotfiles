#!/usr/bin/env bash
# mini-sync — mirror this laptop's dotfiles tree and personal CLIs to the
# office Mac mini. One-way: the laptop is the source of truth and the mini's
# copy is overwritten, so never edit ~/dotfiles on the mini.
# Why a mirror and not `git pull`: skills and tools iterate uncommitted, and
# the mirror carries the working tree as-is. See docs/qiushi-mini.md § Sync.
#
# Also: the links of the packages the mini stows (STOW), CLI token files
# (SECRETS), pnpm-global engines at the laptop's version (ENGINES), and the
# laptop's theme, below.
#
# Usage: mini-sync [-n|--dry-run] [-q|--quiet]
#   --quiet  for the launchd timer: exit 0 silently when the mini is unreachable
set -euo pipefail

HOST=${MINI_HOST:-qiushi-mini}
REPO="$HOME/dotfiles"
# Compiled, self-contained CLIs from ~/.local/bin. Launcher shims that exec
# into a local checkout (planlab, bench) do not belong here: they point at
# laptop paths.
BINS=(headroom envoy brief gwt gopen cout slack-digest slack claude-steps)
# Token files or directories (paths relative to $HOME), sent 600 in 700
# dirs. Only CLI API tokens belong here, with the private config that travels
# beside them (~/.config/slack: slackkit's tokens.env, read by slack and
# slack-digest; ~/.config/slack-digest: config, workspace notes). OAuth logins
# (Claude Code, Codex, gh) rotate their refresh tokens, so two machines
# sharing one log each other out; the mini logs in on its own.
SECRETS=(.planlab/.env .bench/.env .config/slack .config/slack-digest)
# Packages the mini stows: the config of what runs there, and what its agent
# sessions read (lessons behind the skills, the snippets TabType pastes over
# ssh), and karabiner since the mini has a keyboard on it. Left out: a package
# whose config the mini owns (git: its own identity; codex: generated below),
# one that needs a tool the mini lacks (lazygit: delta), the laptop's other
# GUI apps, and scripts (next).
STOW=(claude claude-steps ghostty gwt karabiner lessons nvim ohmyposh tabtype tmux zsh)
# Mirror scripts the mini runs by name. The scripts package is not stowed
# there (it carries this laptop's mini-sync LaunchAgent), so each gets a
# link in the mini's ~/.local/bin, pointing into the mirror.
LINKS=(theme-set toclip browser-clip mac aws-login snapshot)
# pnpm-global CLIs behind skills the mirror carries. A skill is written
# against the laptop's engine, so the mini installs the laptop's exact version
# whenever its own differs. Not copied like BINS: they are node packages.
ENGINES=(@obelisk-apps/cli)
# The mini records the last theme this script applied there, so a theme
# picked on the mini (prefix t) lasts until the laptop switches.
THEME_STATE=.local/state/mini-sync/theme

dry=() quiet=0 rc=0
for arg in "$@"; do
  case $arg in
    -n|--dry-run) dry=(--dry-run --itemize-changes) ;;
    -q|--quiet) quiet=1 ;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "mini-sync: unknown argument: $arg" >&2; exit 2 ;;
  esac
done

say() { (( quiet )) || printf '%s\n' "$*"; }

if ! ssh -o BatchMode=yes -o ConnectTimeout=5 "$HOST" true 2>/dev/null; then
  (( quiet )) && exit 0
  echo "mini-sync: $HOST unreachable" >&2
  exit 1
fi

# Everything git can see (tracked + untracked-not-ignored) plus .git itself.
# Ignored paths stay behind: ssh config, purchased upstream
# material, app runtime state, node_modules. Anchored so a name excludes
# only that path.
work=$(mktemp -d "${TMPDIR:-/tmp}/mini-sync.XXXXXX")
trap 'rm -rf "$work"' EXIT
excludes="$work/excludes"
git -C "$REPO" ls-files -o -i --exclude-standard --directory | sed 's|^|/|' > "$excludes"
echo '.DS_Store' >> "$excludes"

# Skills owned by other projects are links out of the tree (read-email →
# ~/dev/mailkit, slack → ~/dev/slackkit); the mini has no such checkouts, so
# --copy-unsafe-links carries those as real directories. Links inside the
# tree stay links.
say "==> dotfiles → $HOST:~/dotfiles"
rsync -a --delete --copy-unsafe-links ${dry[@]+"${dry[@]}"} --exclude-from="$excludes" \
  "$REPO/" "$HOST:dotfiles/"

# Stow links per item, so a file added to or removed from a package changes
# which links the mini needs, and nobody runs `make restow` there. A restow
# leaves an unchanged tree's links untouched. The mirror's Makefile runs it:
# it makes the directories that must stay real first (docs/stow-layout.md).
# A conflict aborts the whole restow and fails this run, after the rest.
say "==> ${STOW[*]} → $HOST:~ (restow from the mirror)"
if (( ${#dry[@]} )); then
  say "    would restow"
elif ! ssh "$HOST" "make -s -C ~/dotfiles restow PACKAGES='${STOW[*]}'"; then
  echo "mini-sync: restow failed on $HOST; its links may be stale" >&2
  rc=1
fi

# Codex's config.toml can't be a link like the claude package: Codex writes
# its trust decisions into it. Derive the mini's copy from the laptop's
# instead, keeping the tables Codex owns there (mini-codex-config.py).
say "==> codex config → $HOST:~/.codex/config.toml"
ssh "$HOST" 'cat ~/.codex/config.toml 2>/dev/null' > "$work/mini.toml" || true
python3 "$REPO/scripts/.local/share/dotfiles/mini-codex-config.py" \
  "$REPO/codex/.codex/config.toml" "$work/mini.toml" > "$work/new.toml"
if cmp -s "$work/mini.toml" "$work/new.toml"; then
  say "    unchanged"
elif (( ${#dry[@]} )); then
  diff -u "$work/mini.toml" "$work/new.toml" || true
else
  ssh "$HOST" 'mkdir -p ~/.codex && umask 077 && cat > ~/.codex/config.toml.mini-sync && mv ~/.codex/config.toml.mini-sync ~/.codex/config.toml' < "$work/new.toml"
fi

say "==> ${BINS[*]} → $HOST:~/.local/bin"
bins=()
for b in "${BINS[@]}"; do
  if [[ -x $HOME/.local/bin/$b ]]; then
    bins+=("$HOME/.local/bin/$b")
  else
    echo "mini-sync: skipping $b (not installed here)" >&2
  fi
done
rsync -a ${dry[@]+"${dry[@]}"} "${bins[@]}" "$HOST:.local/bin/"

say "==> ${SECRETS[*]} → $HOST:~"
secrets=()
for s in "${SECRETS[@]}"; do
  [[ -e $HOME/$s ]] && secrets+=("$HOME/./$s")
done
# -R keeps the path after /./. Parents are made on the mini first (700 when
# new, untouched when present) and --no-implied-dirs keeps rsync off them, so
# --chmod reaches only the listed paths: ~/.config itself stays as it is.
if (( ${#secrets[@]} )); then
  parents=()
  for s in "${SECRETS[@]}"; do [[ -e $HOME/$s && $s == */* ]] && parents+=("${s%/*}"); done
  (( ${#dry[@]} || ${#parents[@]} == 0 )) || ssh "$HOST" "umask 077 && mkdir -p ${parents[*]}"
  rsync -aR --no-implied-dirs --chmod=D700,F600 ${dry[@]+"${dry[@]}"} "${secrets[@]}" "$HOST:"
fi

say "==> ${LINKS[*]} → $HOST:~/.local/bin (links into the mirror)"
if (( ${#dry[@]} )); then
  say "    would ensure the links"
else
  ssh "$HOST" "mkdir -p ~/.local/bin && for n in ${LINKS[*]}; do ln -sfn ../../dotfiles/scripts/.local/bin/\$n ~/.local/bin/\$n; done"
fi

# The laptop's theme goes through the mini's own theme-set, which writes the
# name and the Ghostty include there and reloads the mini's tmux. It runs only
# when the laptop's theme differs from the last one applied, unlike the Codex
# config above, which is rewritten whenever the mini's copy differs.
say "==> theme → $HOST"
theme=$(tr -d '[:space:]' < "$HOME/.config/terminal-theme" 2>/dev/null || true)
if [[ ! $theme =~ ^[a-z0-9_]+$ ]]; then
  say "    no laptop theme"
else
  applied=$(ssh "$HOST" "cat ~/$THEME_STATE 2>/dev/null" || true)
  if [[ $applied == "$theme" ]]; then
    say "    unchanged"
  elif (( ${#dry[@]} )); then
    say "    would apply $theme (last applied: ${applied:-none})"
  else
    ssh "$HOST" "~/.local/bin/theme-set $theme >/dev/null && mkdir -p ~/${THEME_STATE%/*} && echo $theme > ~/$THEME_STATE"
    say "    applied $theme"
  fi
fi

# Last, so a failed install cannot hold back the steps above. The version
# check is one pnpm call per side; pnpm itself runs only when they differ.
say "==> ${ENGINES[*]} → $HOST (pnpm global, laptop's versions)"
local_json=$(zsh -c 'pnpm ls -g --json')
remote_json=$(ssh "$HOST" 'pnpm ls -g --json')
installs=()
for e in "${ENGINES[@]}"; do
  want=$(jq -r --arg p "$e" '.[0].dependencies[$p].version // empty' <<<"$local_json")
  have=$(jq -r --arg p "$e" '.[0].dependencies[$p].version // empty' <<<"$remote_json")
  if [[ -z $want ]]; then
    echo "mini-sync: skipping $e (not installed here)" >&2
  elif [[ $want != "$have" ]]; then
    installs+=("$e@$want")
    say "    $e ${have:-absent} → $want"
  fi
done
if (( ${#installs[@]} == 0 )); then
  say "    unchanged"
elif (( ${#dry[@]} )); then
  say "    would install ${installs[*]}"
else
  if (( quiet )); then
    ssh "$HOST" "pnpm add -g ${installs[*]}" >/dev/null
  else
    ssh "$HOST" "pnpm add -g ${installs[*]}"
  fi
fi

if (( rc )); then exit "$rc"; fi
say "==> done"
