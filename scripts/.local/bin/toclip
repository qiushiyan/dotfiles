#!/usr/bin/env bash
# toclip — put text on the clipboard of the machine you are sitting at.
#
#   <cmd> | toclip       toclip <text>...       (-q: no report on stderr)
#   toclip --remote      exit 0 if a copy from here would go through a terminal
#                        (an ssh client's, or the Rex app showing this pane),
#                        1 if it would stay on this machine
#
# At a machine's own screen (the laptop, or the mini at its desk or over Screen
# Sharing) it is pbcopy. In an ssh session to the mini it asks the laptop's
# terminal to copy, over OSC 52: inside tmux through `load-buffer -w` aimed at
# the session's ssh client, outside tmux straight at the session's tty. In a
# Rex pane it always asks the terminal: Rex hands OSC 52 to the app showing the
# session, on whichever machine that is. A tmux session can be on both screens
# at once, and then the client last typed at says which one you are at. The
# request is fire-and-forget — a terminal that ignores OSC 52 (Terminal.app)
# drops it — so inside tmux the text also stays as the newest tmux buffer,
# which `frommini` on the laptop fetches. See docs/qiushi-mini.md § Clipboard
# and attach.
set -euo pipefail

# Larger payloads stay in the tmux buffer only: tmux's input-buffer-size is
# 1 MiB of encoded sequence, and the terminal side's ceiling is untested.
OSC52_MAX=${TOCLIP_OSC52_MAX:-524288}

quiet=0 query=0
case ${1:-} in
  -q) quiet=1; shift ;;
  --remote) query=1; shift ;;
esac
case ${1:-} in -h|--help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; esac

say() { (( quiet )) || printf 'toclip: %s\n' "$*" >&2; }
die() { printf 'toclip: %s\n' "$*" >&2; exit 1; }

# A client is remote when an sshd sits among its process's ancestors: the
# laptop's `ssh mini` attaches through sshd, the Screen Sharing Ghostty does
# not. TOCLIP_REMOTE_PIDS (space-separated) replaces the walk in tests.
is_remote() {
  local pid=$1 comm i
  if [[ -n ${TOCLIP_REMOTE_PIDS+set} ]]; then
    [[ " $TOCLIP_REMOTE_PIDS " == *" $pid "* ]]; return
  fi
  for i in 1 2 3 4 5 6 7 8; do
    comm=$(ps -o comm= -p "$pid" 2>/dev/null) || return 1
    [[ $comm == *sshd* ]] && return 0
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    [[ -z $pid || $pid -le 1 ]] && return 1
  done
  return 1
}

# The tty of the nearest ancestor that has one. A detached caller (Claude
# Code's link handler) has no /dev/tty of its own.
caller_tty() {
  if { : > /dev/tty; } 2>/dev/null; then printf '/dev/tty'; return; fi
  local pid=$$ t i
  for i in 1 2 3 4 5 6; do
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    [[ -z $pid || $pid -le 1 ]] && return 1
    t=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
    case $t in ''|'??') ;; *) printf '/dev/%s' "$t"; return ;; esac
  done
  return 1
}

# Where a copy goes, decided now rather than from the environment: a tmux pane
# keeps the environment it was created with, whichever client views it later.
# Of the session's clients, the one with the newest input decides: the laptop's
# ssh client can stay attached while you work at the mini's desk, and the
# keypress that asked for this copy came from the screen you are at.
remote=0 rex=0 target= newest=-1
if [[ -n ${TMUX:-} ]]; then
  session=$(tmux display-message -p -t "${TMUX_PANE:-}" '#{session_id}')
  while read -r activity pid name; do
    (( activity > newest )) || continue
    newest=$activity
    if is_remote "$pid"; then remote=1 target=$name; else remote=0 target=; fi
  done < <(tmux list-clients -t "$session" -F '#{client_activity} #{client_pid} #{client_name}')
elif [[ -n ${REX_BLOCK:-} ]]; then
  # A Rex pane's SSH variables are those of the shell that started the server,
  # and every app stays attached to every session, so neither says where you
  # are. The terminal's copy reaches you wherever you are.
  remote=1 rex=1
elif [[ -n ${SSH_CONNECTION:-} ]]; then
  remote=1
fi
(( query )) && exit $(( remote ? 0 : 1 ))

work=$(mktemp -d "${TMPDIR:-/tmp}/toclip.XXXXXX")
trap 'rm -rf "$work"' EXIT
payload=$work/payload
if (( $# )); then printf '%s' "$*" > "$payload"; else cat > "$payload"; fi
[[ -s $payload ]] || die "nothing to copy"
size=$(wc -c < "$payload" | tr -d ' ')

local_copy() { LANG=en_US.UTF-8 pbcopy < "$payload"; }

if [[ -n ${TMUX:-} ]]; then
  if [[ -z $target ]]; then
    tmux load-buffer - < "$payload"
    local_copy
    say "copied $size bytes here"
  elif (( size > OSC52_MAX )); then
    tmux load-buffer - < "$payload"
    say "$size bytes is too large to send through the terminal; kept as the newest tmux buffer — run frommini on the laptop"
    exit 1
  else
    tmux load-buffer -w -t "$target" - < "$payload"
    say "sent $size bytes to the laptop terminal ($target); also kept as the newest tmux buffer"
  fi
elif (( remote )); then
  if (( size > OSC52_MAX )); then
    (( rex )) || die "$size bytes is too large to send through the terminal"
    local_copy
    say "$size bytes is too large to send through the terminal; copied to this machine's pasteboard instead"
    exit 1
  fi
  tty=$(caller_tty) || die "no terminal to send to"
  printf '\033]52;c;%s\a' "$(base64 < "$payload" | tr -d '\n')" > "$tty"
  if (( rex )); then
    say "sent $size bytes to the Rex app showing this pane"
  else
    say "sent $size bytes to the laptop terminal"
  fi
else
  local_copy
  say "copied $size bytes"
fi
