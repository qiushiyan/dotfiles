#!/usr/bin/env bash
# claude-usage — Claude Code's /usage view, outside Claude Code, across accounts.
# System model and use patterns: docs/claude-accounts.md.
#
# Data source: the (undocumented) endpoint the /usage screen itself calls:
#   GET https://api.anthropic.com/api/oauth/usage   (OAuth Bearer token)
# The token comes from the macOS Keychain, where Claude Code keeps one item
# per config dir:
#   default ~/.claude        → service "Claude Code-credentials"
#   CLAUDE_CONFIG_DIR=<dir>  → service "Claude Code-credentials-<hash8>"
# where <hash8> = first 8 hex chars of sha256(<dir>) — matches the service-name
# code in the Claude Code binary (verified on v2.1.220). This is what makes
# multiple simultaneous logins possible: each config dir is its own login.
#
# Accounts are discovered, not configured: the default ~/.claude plus every
# dir under ~/.claude-accounts/<email>/ (seeded by claude-account-add and
# launched by x-<name>, both in ~/.config/zsh/claude.zsh). Each account is
# labeled with the email its .claude.json reports as actually logged in,
# falling back to the dir name before first login. ~/.claude-accounts/.order
# (one email per line, optional) sets display order after the primary;
# unlisted accounts follow alphabetically.
#
# Read-only by design: tokens are never refreshed or written here. If one has
# expired, opening any Claude Code session on that account refreshes it.
# Accounts fail independently: a bad blob or drifted response marks that one
# account and the rest still render. Usage fetches run in parallel, so a dead
# network costs one timeout, not one per account.
#
# BLOB_JQ / LIMITS_JQ are the only credential/response parsers — the dashboard
# renders through them and `claude-usage --check` asserts through them, so the
# checker cannot drift from what rendering actually needs. Run --check after a
# Claude Code update or whenever the dashboard misbehaves.

set -euo pipefail

# Keep these three in sync with ~/.config/zsh/claude.zsh.
ACCOUNTS_ROOT="$HOME/.claude-accounts"
STATE="$ACCOUNTS_ROOT/.current"
PRIMARY_NAME="qiushi"

ORDER_FILE="$ACCOUNTS_ROOT/.order"
URL="https://api.anthropic.com/api/oauth/usage"
BARW=20
CURL_TIMEOUT=10

command -v jq >/dev/null || { echo "claude-usage: jq is required" >&2; exit 1; }

if [[ -t 1 ]]; then
  BOLD=$'\e[1m'; DIM=$'\e[2m'; RED=$'\e[31m'; YEL=$'\e[33m'; GRN=$'\e[32m'; RST=$'\e[0m'
else
  BOLD=""; DIM=""; RED=""; YEL=""; GRN=""; RST=""
fi

# The account bare `x` targets (email, or PRIMARY_NAME for ~/.claude).
CURRENT=$(cat "$STATE" 2>/dev/null) || CURRENT=""
[[ -z "$CURRENT" ]] && CURRENT="$PRIMARY_NAME"

service_name() {  # $1 = config dir ("" = default)
  local base="Claude Code-credentials"
  if [[ -z "$1" ]]; then
    echo "$base"
  else
    echo "$base-$(printf %s "$1" | shasum -a 256 | cut -c1-8)"
  fi
}

# ---------------------------------------------------------------- parsers --
# The single credential contract: token, expiry(ms), plan, tier — tab-joined.
BLOB_JQ='.claudeAiOauth
  | [ (.accessToken // "" | tostring),
      ((.expiresAt // 0) | tostring),
      (.subscriptionType // "?" | tostring),
      ((.rateLimitTier // "") | tostring) ]
  | @tsv'

# The single response contract: one "label \t percent \t reset-epoch \t
# severity" row per limit. Tolerant on purpose — a weird field degrades to
# 0 / "?" instead of aborting the account; --check layers strict assertions
# (row count, parseable timestamps) on this same parser's output.
LIMITS_JQ='(.limits // []) as $l
  | (if ($l | type) == "array" and ($l | length) > 0 then $l
     else [ .five_hour // empty
            | { kind: "session", percent: (.utilization // 0),
                resets_at, severity: "normal", scope: null } ]
     end)
  | .[]
  | ((try .scope.model.display_name catch null) // "" | tostring) as $model
  | [ (if .kind == "session" then "5h session"
       elif $model != "" then $model + " (7d)"
       elif .group == "weekly" then "All models (7d)"
       else ((.group // .kind // "?") | tostring) end),
      (try ((.percent // 0) | tonumber | round) catch 0),
      ((.resets_at // "" | tostring) | sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z")
                          | (try fromdateiso8601 catch 0)),
      ((.severity // "normal") | tostring)
    ] | @tsv'

# -------------------------------------------------------------- discovery --
dirs=("")   # "" = the primary ~/.claude

_have_dir() {
  local x
  for x in "${dirs[@]}"; do [[ "$x" == "$1" ]] && return 0; done
  return 1
}

if [[ -f "$ORDER_FILE" ]]; then
  while IFS= read -r line; do
    line=${line%%#*}; line=${line//[[:space:]]/}
    [[ -z "$line" ]] && continue
    d="$ACCOUNTS_ROOT/$line"
    [[ -d "$d" ]] && ! _have_dir "$d" && dirs+=("$d")
  done < "$ORDER_FILE"
fi
for d in "$ACCOUNTS_ROOT"/*/; do
  [[ -d "$d" ]] || continue
  d=${d%/}
  _have_dir "$d" || dirs+=("$d")
done

# The launcher to advertise for an account. Mirrors _claude_gen_launchers in
# claude.zsh: x-<email> always exists; the short x-<local-part> alias exists
# only when the local part is unique among accounts and isn't the primary's
# name or a reserved utility name (x-usage etc.) — keep the rules and the
# reserved list in sync.
xcmd_for() {  # $1 = dir ("" = primary)
  if [[ -z "$1" ]]; then
    echo "x-$PRIMARY_NAME"
    return
  fi
  local email=${1##*/} lp n=0 d e
  lp=${email%%@*}
  case "$lp" in
    usage|account|account-add) echo "x-$email"; return ;;
  esac
  for d in "${dirs[@]}"; do
    [[ -z "$d" ]] && continue
    e=${d##*/}
    [[ "${e%%@*}" == "$lp" ]] && n=$(( n + 1 ))
  done
  if [[ "$lp" != "$email" && "$lp" != "$PRIMARY_NAME" && "$n" == 1 ]]; then
    echo "x-$lp"
  else
    echo "x-$email"
  fi
}

# ------------------------------------------------------------------ check --
# Verify the assumptions this script reverse-engineered from Claude Code.
# Each FAIL means Claude Code likely changed a format on update.
run_check() {
  local fails=0 ok
  chk() {  # $1 = 0 ok / else fail, $2 = label, $3 = hint on fail
    if [[ "$1" == "0" ]]; then
      printf '%s ok %s  %s\n' "$GRN" "$RST" "$2"
    else
      printf '%sFAIL%s  %s%s\n' "$RED" "$RST" "$2" "${3:+ — $3}"
      fails=$(( fails + 1 ))
    fi
  }

  # The installed binary still carries the seams this tooling depends on:
  # the usage endpoint, config-dir routing, and the credentials service name.
  local bin s missing=""
  bin=$(readlink -f "$(command -v claude)" 2>/dev/null) || bin=""
  for s in "api/oauth/usage" "CLAUDE_CONFIG_DIR" "CLAUDE_SECURESTORAGE_CONFIG_DIR" "-credentials"; do
    { [[ -n "$bin" ]] && grep -aq -- "$s" "$bin" 2>/dev/null; } || missing="$missing $s"
  done
  ok=1; [[ -n "$bin" && -z "$missing" ]] && ok=0
  chk $ok "binary (${bin##*/}): endpoint + config-dir + credential seams present" "missing:${missing:- binary not found}"

  # Keychain items exist under the predicted service names, and every
  # credential blob parses through the same contract the dashboard uses.
  # (Items were written by past logins — this proves the naming derivation
  # matches what Claude Code created, not what a future binary will do;
  # the seam greps above cover the binary side.)
  local dir b blob creds token expires_ms
  local any_epoch=0 now_ms
  now_ms=$(( $(date +%s) * 1000 ))
  for dir in "${dirs[@]}"; do
    b=${dir:+${dir##*/}}; b=${b:-primary}
    if [[ -n "$dir" && ! -f "$dir/.claude.json" ]]; then
      continue   # never logged in — nothing to verify
    fi
    ok=0; security find-generic-password -s "$(service_name "$dir")" -a "$USER" >/dev/null 2>&1 || ok=1
    chk $ok "keychain[$b]: item under predicted name" "not logged in, or naming scheme changed"

    blob=$(security find-generic-password -s "$(service_name "$dir")" -a "$USER" -w 2>/dev/null) || blob=""
    creds=$(jq -r "$BLOB_JQ" <<<"$blob" 2>/dev/null) || creds=""
    token=""; expires_ms=0
    [[ -n "$creds" ]] && IFS=$'\t' read -r token expires_ms _ _ <<<"$creds"
    ok=1; [[ -n "$token" ]] && ok=0
    chk $ok "blob[$b]: parses via shared contract (accessToken present)"

    # Live contract, through the same parser rendering uses.
    if [[ -n "$token" ]] && ! { [[ "$expires_ms" =~ ^[0-9]+$ ]] && (( expires_ms > 0 && expires_ms < now_ms )); }; then
      local resp code body rows nrows
      resp=$(curl -sS --max-time "$CURL_TIMEOUT" -w $'\n%{http_code}' "$URL" -H "Authorization: Bearer $token" 2>/dev/null) || resp=""
      code=${resp##*$'\n'}; body=${resp%$'\n'*}
      rows=""; { [[ "$code" == "200" ]] && rows=$(jq -r "$LIMITS_JQ" <<<"$body" 2>/dev/null); } || rows=""
      nrows=0; [[ -n "$rows" ]] && nrows=$(wc -l <<<"$rows" | tr -d ' ')
      ok=1; (( nrows >= 1 )) && ok=0
      chk $ok "api[$b]: HTTP ${code:-n/a}, $nrows row(s) via shared parser"
      local _l _p _r _s
      while IFS=$'\t' read -r _l _p _r _s; do
        [[ "$_r" =~ ^[0-9]+$ ]] && (( _r > 0 )) && any_epoch=1
      done <<<"$rows"
    else
      chk 1 "api[$b]: skipped" "token missing or expired — run $(xcmd_for "$dir") first"
    fi
  done

  # If no reset timestamp parsed anywhere, the timestamp format drifted even
  # though the tolerant parser kept rendering (it would show "resets ?").
  ok=1; (( any_epoch )) && ok=0
  chk $ok "timestamps: at least one resets_at parsed to an epoch" "resets_at format drifted"

  # .claude.json still records the logged-in email (dashboard labels).
  ok=1
  { jq -e '.oauthAccount.emailAddress | type == "string"' "$HOME/.claude.json" >/dev/null 2>&1 && ok=0; } || true
  chk $ok "claude.json: .oauthAccount.emailAddress present"

  echo
  if (( fails )); then
    echo "$fails check(s) failed — Claude Code likely changed a format; see docs/claude-accounts.md"
    exit 1
  fi
  echo "all checks passed"
  exit 0
}

case "${1:-}" in
  --check) run_check ;;
  -h|--help) echo "usage: claude-usage [--check]"; exit 0 ;;
esac

# ----------------------------------------------------------------- render --
# One limit row: "  <label>  [██████░░...]  56%  resets Wed 18:00 (in 4d 20h)"
render_row() {  # $1 label, $2 percent, $3 reset epoch (0 = unknown), $4 severity
  local label="$1" pct="$2" reset="$3" sev="$4" now filled color when rem
  now=$(date +%s)

  color=$GRN
  (( pct >= 50 )) && color=$YEL
  (( pct >= 80 )) && color=$RED
  [[ "$sev" != "normal" ]] && color=$RED

  filled=$(( (pct * BARW + 50) / 100 ))
  (( filled > BARW )) && filled=$BARW
  (( filled < 0 )) && filled=0
  local bar
  bar=$(printf '%*s' "$filled" '' | tr ' ' '█')$(printf '%*s' $((BARW - filled)) '' | tr ' ' '░')

  if (( reset == 0 )); then
    when="resets ?"
  else
    rem=$(( reset - now ))
    if (( rem <= 0 )); then
      when="resetting…"
    else
      local d=$(( rem / 86400 )) h=$(( rem % 86400 / 3600 )) m=$(( rem % 3600 / 60 )) in
      if   (( d > 0 )); then in="${d}d ${h}h"
      elif (( h > 0 )); then in="${h}h ${m}m"
      else                   in="${m}m"
      fi
      if (( rem < 86400 )); then
        when="resets $(date -r "$reset" '+%H:%M') (in $in)"
      else
        when="resets $(date -r "$reset" '+%a %H:%M') (in $in)"
      fi
    fi
  fi

  printf '  %-16s %s[%s]%s %3d%%  %s%s%s\n' "$label" "$color" "$bar" "$RST" "$pct" "$DIM" "$when" "$RST"
}

# ------------------------------------------------------------ prep + fetch --
# Phase 1 walks accounts, resolves labels/credentials, and launches all usage
# fetches in parallel; phase 2 waits; phase 3 renders in order. Any per-account
# problem becomes a status rendered for that account alone.
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

labels=(); plans=(); xcmds=(); marks=(); statuses=()
now_ms=$(( $(date +%s) * 1000 ))

prep_account() {  # $1 = index, $2 = config dir ("" = primary)
  local i="$1" dir="$2" svc meta name email label xcmd mark blob creds
  local token="" expires_ms=0 subtype="?" tier="" plan=""
  svc=$(service_name "$dir")

  if [[ -z "$dir" ]]; then
    meta="$HOME/.claude.json"; name="primary"
  else
    meta="$dir/.claude.json"; name="${dir##*/}"
  fi
  email=$(jq -r '.oauthAccount.emailAddress // empty' "$meta" 2>/dev/null) || email=""
  label=${email:-$name}
  # A dir whose login doesn't match its name means /login picked the wrong
  # account in that session — surface it instead of hiding it.
  if [[ -n "$dir" && -n "$email" && "$email" != "$name" ]]; then
    label="$email ${RED}(dir says $name!)${RST}"
  fi

  xcmd=$(xcmd_for "$dir")
  mark=""
  if [[ -z "$dir" && "$CURRENT" == "$PRIMARY_NAME" ]] || [[ -n "$dir" && "$CURRENT" == "$name" ]]; then
    mark="  ${BOLD}← x${RST}"
  fi
  labels[$i]="$label"; xcmds[$i]="$xcmd"; marks[$i]="$mark"; plans[$i]=""

  blob=$(security find-generic-password -s "$svc" -a "$USER" -w 2>/dev/null) || blob=""
  # Linux / keychain-unavailable fallback: Claude Code writes this file instead.
  [[ -z "$blob" && -n "$dir" && -f "$dir/.credentials.json" ]] && blob=$(cat "$dir/.credentials.json")
  if [[ -z "$blob" ]]; then
    statuses[$i]="nologin"
    return
  fi

  creds=$(jq -r "$BLOB_JQ" <<<"$blob" 2>/dev/null) || creds=""
  [[ -n "$creds" ]] && IFS=$'\t' read -r token expires_ms subtype tier <<<"$creds"
  if [[ -z "$token" ]]; then
    statuses[$i]="badblob"
    return
  fi
  # "default_claude_max_20x" → "max 20x"; fall back to subscriptionType.
  plan="$subtype"
  if [[ -n "$tier" ]]; then
    plan=${tier#default_claude_}
    plan=${plan//_/ }
  fi
  plans[$i]="$plan"

  if [[ "$expires_ms" =~ ^[0-9]+$ ]] && (( expires_ms > 0 && expires_ms < now_ms )); then
    statuses[$i]="expired"
    return
  fi

  statuses[$i]="fetched"
  curl -sS --max-time "$CURL_TIMEOUT" -w $'\n%{http_code}' "$URL" \
       -H "Authorization: Bearer $token" > "$TMP/$i.resp" 2>/dev/null &
}

render_account() {  # $1 = index
  local i="$1"
  local plan="${plans[$i]}"   # separate `local`: the shell expands all words before any assignment lands
  if [[ -n "$plan" ]]; then
    printf '%s%s%s %s(%s · %s)%s%s\n' "$BOLD" "${labels[$i]}" "$RST" "$DIM" "$plan" "${xcmds[$i]}" "$RST" "${marks[$i]}"
  else
    printf '%s%s%s  %s%s%s%s\n' "$BOLD" "${labels[$i]}" "$RST" "$DIM" "${xcmds[$i]}" "$RST" "${marks[$i]}"
  fi

  case "${statuses[$i]}" in
    nologin)
      printf '  %snot logged in — run %s and /login%s\n' "$DIM" "${xcmds[$i]}" "$RST"
      return ;;
    badblob)
      printf '  %scredential blob unreadable — format changed? run claude-usage --check%s\n' "$DIM" "$RST"
      return ;;
    expired)
      printf '  %stoken expired — run %s to refresh it%s\n' "$DIM" "${xcmds[$i]}" "$RST"
      return ;;
  esac

  local resp code body rows
  resp=$(cat "$TMP/$i.resp" 2>/dev/null) || resp=""
  if [[ -z "$resp" ]]; then
    printf '  %sfetch failed (network?)%s\n' "$DIM" "$RST"
    return
  fi
  code=${resp##*$'\n'}
  body=${resp%$'\n'*}
  if [[ "$code" != "200" ]]; then
    printf '  %sHTTP %s from usage endpoint%s\n' "$DIM" "$code" "$RST"
    return
  fi

  if ! rows=$(jq -r "$LIMITS_JQ" <<<"$body" 2>/dev/null); then
    printf '  %sresponse not parseable — format changed? run claude-usage --check%s\n' "$DIM" "$RST"
    return
  fi
  if [[ -z "$rows" ]]; then
    printf '  %sno limits reported%s\n' "$DIM" "$RST"
    return
  fi

  local l p r s
  while IFS=$'\t' read -r l p r s; do
    [[ "$p" =~ ^-?[0-9]+$ ]] || p=0
    [[ "$r" =~ ^[0-9]+$ ]] || r=0
    render_row "$l" "$p" "$r" "$s"
  done <<<"$rows"
}

i=0
for dir in "${dirs[@]}"; do
  prep_account "$i" "$dir"
  i=$(( i + 1 ))
done
wait

i=0
first=1
for dir in "${dirs[@]}"; do
  (( first )) || echo
  first=0
  render_account "$i"
  i=$(( i + 1 ))
done
