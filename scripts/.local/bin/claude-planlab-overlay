#!/usr/bin/env python3
"""claude-planlab-overlay — this operator's own view of a PlanLab checkout, for
one interactive Claude Code launch.

Usage:
  claude-planlab-overlay <claude args...>   what claude.zsh's _claude_launch runs before headroom
  claude-planlab-overlay --show             in a checkout: what its sessions read, as a diff of
                                            the team's AGENTS.md, the note, the skills they see,
                                            and whether this checkout's team hooks honour the
                                            operator's switches

What it keeps, cuts and adds is ~/.local/share/dotfiles/planlab-overlay.toml
(CLAUDE_PLANLAB_OVERLAY_CONFIG overrides it).

Inside a PlanLab checkout it prints the launch's args rewritten, each ended by
a NUL, says on stderr in one line what it did, and exits 0. Outside one it
prints nothing and exits 1. On any failure inside one it says why on stderr
and exits 1. Either way the launch keeps its args: a session gets the team's
instructions whole, never half of this overlay.

What the rewritten launch changes, for that session and its subagents:
  AGENTS.md  The team copy is excluded (claudeMdExcludes on the checkout's
             .claude/CLAUDE.md, whose one line imports it), and a copy with the
             config's cuts and note is the CLAUDE.md of a cached directory the
             launch adds (--add-dir=, with
             CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1 in its settings).
             That is project memory, as the team's file is, so subagents read
             it too; an appended system prompt reaches the main session alone.
             A cut that no longer matches leaves its text in and is named on
             stderr.
  skills     Every skill in the checkout's .claude/skills outside the config's
             keep globs is user-invocable-only (hidden from the model, still a
             / command). A kept skill gets no override, so it stays as its
             own frontmatter and the checkout's settings.local.json have it
             (pl-close hides itself from the model by design; a launch
             --settings would outrank both). A name the operator's own skills
             also use is left alone, since overrides are keyed by name.
  --settings Claude Code applies only the last --settings, so one given to
             the launch (--fast's, or typed) is merged into this file, its
             keys winning; a launch whose --settings cannot be read keeps its
             args.

Why launch arguments and not a hook or a settings file (verified on Claude
Code 2.1.319): hook additionalContext over 10,000 characters reaches the
model only as a file path; CLAUDE.md files are read before SessionStart hooks
run; --setting-sources without project also drops the project's skills and
its nested CLAUDE.md files; additionalDirectories in a settings file load no
CLAUDE.md; skillOverrides take exact names, so a fixed list goes stale as the
team adds skills. The = in --add-dir= keeps the variadic flag from taking the
launch's prompt as a second directory.

The reminders the team's hooks give are switched off separately, by
PLANLAB_BENCH_REMINDERS=off and PLANLAB_CORPUS_REMINDERS=off (the user
settings' env for Claude, codex.zsh for Codex); this overlay never decides
what those hooks say.
"""

import difflib
import fnmatch
import hashlib
import json
import os
import re
import shutil
import sys
import tempfile
import time
from pathlib import Path

CONFIG = Path(__file__).resolve().parents[1] / "share" / "dotfiles" / "planlab-overlay.toml"
# A flag that chooses the settings sources: with it the overlay stands aside.
CONFLICTS = ("--setting-sources",)
# The team hooks the operator's switches quiet, and the variable each reads.
SWITCHES = ((".agents/skills/pl-bench-tasks/scripts/lifecycle.py", "PLANLAB_BENCH_REMINDERS"),
            (".agents/skills/pl-scheduling-corpus-capture/scripts/corpus-reminder.py", "PLANLAB_CORPUS_REMINDERS"))
CACHE_TTL_SECONDS = 14 * 24 * 3600


class Refusal(Exception):
    """This launch keeps its args. A quiet one is not worth a line: the launch is not in a checkout."""

    def __init__(self, reason, quiet=False):
        super().__init__(reason)
        self.quiet = quiet


def config():
    """The operator's choices: the skills to keep, the cuts, the note."""
    path = Path(os.environ.get("CLAUDE_PLANLAB_OVERLAY_CONFIG") or CONFIG)
    try:
        import tomllib  # Python 3.11+; an older python3 first on PATH is a refusal, not a traceback
        data = tomllib.loads(path.read_text())
        skills, agents = data["skills"], data["agents"]
        lists = [skills["keep"], *(agents.get(k, []) for k in ("drop_sections", "drop_paragraphs", "drop_lines"))]
        if not all(isinstance(x, list) and all(isinstance(i, str) for i in x) for x in lists):
            raise TypeError("lists of strings expected")
        if not isinstance(agents.get("note", ""), str):
            raise TypeError("note is not a string")
    except (ImportError, OSError, ValueError, KeyError, TypeError) as error:
        raise Refusal(f"config {path}: {error}")
    return data


def checkout(start):
    """The PlanLab checkout holding start: the nearest .claude/CLAUDE.md, when it is the one-line import of
    AGENTS.md beside the team's Bench skill.

    claude.zsh's _claude_overlay does not run this program at all when no directory above the launch holds
    .agents/skills/pl-bench-tasks, so a checkout must keep requiring it here."""
    for directory in (start, *start.parents):
        entry = directory / ".claude" / "CLAUDE.md"
        if entry.is_file():
            is_planlab = (entry.read_text().strip() == "@../AGENTS.md" and (directory / "AGENTS.md").is_file()
                          and (directory / ".agents" / "skills" / "pl-bench-tasks").is_dir())
            return directory if is_planlab else None
    return None


def filtered(text, agents):
    """AGENTS.md without the config's sections, paragraphs and lines, and the cuts that matched nothing."""
    misses = []
    for heading in agents.get("drop_sections", []):
        text, n = re.subn(r"^## " + re.escape(heading) + r"\n.*?(?=^## |\Z)", "", text, flags=re.M | re.S)
        misses += [] if n else [heading]
    for opening in agents.get("drop_paragraphs", []):
        text, n = re.subn(r"^" + re.escape(opening) + r".*?(?:\n\n|\Z)", "", text, flags=re.M | re.S)
        misses += [] if n else [opening]
    for prefix in agents.get("drop_lines", []):
        text, n = re.subn(r"^" + re.escape(prefix) + r".*\n", "", text, flags=re.M)
        misses += [] if n else [prefix]
    return text, misses


def own_skill_names():
    roots = {Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude") / "skills",
             Path.home() / ".claude" / "skills"}
    return {entry.name for root in roots if root.is_dir() for entry in root.iterdir()}


def repository_skills(root):
    skills = root / ".claude" / "skills"
    return {entry.name for entry in skills.iterdir() if (entry / "SKILL.md").is_file()} if skills.is_dir() else set()


def skill_overrides(root, keep):
    names = repository_skills(root)
    mine = own_skill_names()
    return {name: "user-invocable-only" for name in sorted(names - mine) if not any(fnmatch.fnmatchcase(name, glob) for glob in keep)}


def given_settings(value):
    """A --settings value: inline JSON, or the path of a JSON file."""
    try:
        settings = json.loads(value) if value.lstrip().startswith("{") else json.loads(Path(value).read_text())
    except (OSError, ValueError) as error:
        raise Refusal(f"unreadable --settings: {error}")
    if not isinstance(settings, dict):
        raise Refusal("--settings is not an object")
    return settings


def split_args(args):
    """(the --settings values given, the args without them), reading flags only before a `--`."""
    given, rest, i = [], [], 0
    while i < len(args):
        arg = args[i]
        if arg == "--":
            rest += args[i:]
            break
        if arg.split("=", 1)[0] in CONFLICTS:
            raise Refusal(f"{arg.split('=', 1)[0]} given")
        if arg == "--settings":
            if i + 1 >= len(args):
                raise Refusal("--settings without a value")
            given.append(args[i + 1])
            i += 2
            continue
        if arg.startswith("--settings="):
            given.append(arg[len("--settings="):])
        else:
            rest.append(arg)
        i += 1
    return given, rest


def merged(base, settings):
    """base with settings on top: their keys win, except that exclusion lists add up and overrides and env merge."""
    result = dict(base)
    for key, value in settings.items():
        if key == "claudeMdExcludes" and isinstance(value, list):
            result[key] = result.get(key, []) + value
        elif key in ("skillOverrides", "env") and isinstance(value, dict):
            result[key] = {**result.get(key, {}), **value}
        else:
            result[key] = value
    return result


def digest(text):
    return hashlib.sha256(text.encode()).hexdigest()[:16]


def written(path, text):
    """path holding text, written atomically when it differs, and touched so the prune keeps it."""
    if not path.is_file() or path.read_text() != text:
        handle, temporary = tempfile.mkstemp(dir=path.parent, prefix=".tmp-")
        with os.fdopen(handle, "w") as stream:
            stream.write(text)
        os.replace(temporary, path)
    os.utime(path)
    os.utime(path.parent)
    return path


def prune(cache):
    """Cached settings and memory directories unused for two weeks."""
    cutoff = time.time() - CACHE_TTL_SECONDS
    for old in cache.glob("*/*"):
        try:
            if old.lstat().st_mtime >= cutoff:
                continue
            if old.is_dir() and not old.is_symlink():
                shutil.rmtree(old)
            else:
                old.unlink()
        except OSError:
            pass


def session_view(root):
    """(the memory a session reads, the filtered team text, the cuts that missed, the skills to hide)."""
    choices = config()
    agents = root / "AGENTS.md"
    text, misses = filtered(agents.read_text(), choices["agents"])
    note = choices["agents"].get("note", "").strip()
    memory = (f"These are the project instructions in {agents}, the team's AGENTS.md, with the sections the "
              f"user does not use left out and the user's own note at the end. Relative paths in them are "
              f"relative to {root}.\n\n{text.strip()}\n" + (f"\n{note}\n" if note else ""))
    return memory, text, misses, skill_overrides(root, choices["skills"]["keep"])


def switch_states(root):
    """Whether this checkout's copy of each team hook reads the operator's switch."""
    states = []
    for script, variable in SWITCHES:
        path = root / script
        if not path.is_file():
            states.append(f"{variable}: this checkout has no {Path(script).name}")
        elif variable in path.read_text():
            states.append(f"{variable}: honoured by this checkout's {Path(script).name}")
        else:
            states.append(f"{variable}: not read by this checkout's {Path(script).name}, which still speaks; pull develop")
    return states


def show(cwd):
    root = checkout(cwd)
    if root is None:
        raise Refusal("not a PlanLab checkout")
    _, text, misses, hidden = session_view(root)
    team = (root / "AGENTS.md").read_text()
    out = list(difflib.unified_diff(team.splitlines(keepends=True), text.splitlines(keepends=True),
                                    "team AGENTS.md", "what a session reads", n=1))
    shown = sorted(repository_skills(root) - set(hidden))
    note = config()["agents"].get("note", "").strip()
    out += [f"\n{len(team)} -> {len(text)} characters, then the note:\n\n{note}\n\n",
            *(f"no match, left in: {miss}\n" for miss in misses),
            *(f"{state}\n" for state in switch_states(root)),
            f"{len(shown)} repository skills visible, {len(hidden)} hidden: {' '.join(shown)}\n"]
    sys.stdout.write("".join(out))


def overlay(args, cwd):
    """(the rewritten args, the one line saying what changed)."""
    root = checkout(cwd)
    if root is None:
        raise Refusal("not a PlanLab checkout", quiet=True)
    given, rest = split_args(args)
    memory, _, misses, hidden = session_view(root)
    # The checkout as the shell names it too, when a symlink makes that differ from the resolved path.
    logical = checkout(Path(os.environ["PWD"])) if os.environ.get("PWD", "").startswith("/") else None
    entries = sorted({str(found / ".claude" / "CLAUDE.md") for found in (root, logical) if found})
    settings = {"claudeMdExcludes": entries, "skillOverrides": hidden,
                "env": {"CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1"}}
    for value in given:
        settings = merged(settings, given_settings(value))
    cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "claude-planlab-overlay"
    directory = cache / digest(str(root))
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    prune(cache)
    settings_text = json.dumps(settings, indent=1)
    settings_file = written(directory / f"settings-{digest(settings_text)}.json", settings_text)
    memory_dir = directory / f"memory-{digest(memory)}"
    memory_dir.mkdir(exist_ok=True, mode=0o700)
    written(memory_dir / "CLAUDE.md", memory)
    line = (f"planlab overlay: the team's AGENTS.md with your cuts and note; "
            f"{len(hidden)} of {len(repository_skills(root))} repository skills hidden")
    line += "".join(f"; no match, left in: {miss!r}" for miss in misses)
    return ["--settings", str(settings_file), f"--add-dir={memory_dir}", *rest], line


def main():
    cwd = Path(os.getcwd()).resolve()
    if sys.argv[1:] == ["--show"]:
        try:
            show(cwd)
            return 0
        except (Refusal, OSError, ValueError, UnicodeDecodeError) as error:
            print(f"claude-planlab-overlay: {error}", file=sys.stderr)
            return 1
    try:
        args, line = overlay(sys.argv[1:], cwd)
    except (Refusal, OSError, ValueError, UnicodeDecodeError) as error:
        if not getattr(error, "quiet", False):
            print(f"planlab overlay: not applied, so this session gets the team's setup whole ({error})",
                  file=sys.stderr)
        return 1
    print(line, file=sys.stderr)
    sys.stdout.write("".join(arg + "\0" for arg in args))
    return 0


if __name__ == "__main__":
    sys.exit(main())
