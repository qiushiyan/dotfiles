#!/usr/bin/env python3
"""claude-planlab-overlay — this operator's own view of a PlanLab checkout, for
one interactive Claude Code launch.

Usage (what claude.zsh's _claude_launch runs before headroom):
  claude-planlab-overlay <claude args...>

Inside a PlanLab checkout it prints the launch's args rewritten, each ended by
a NUL, and exits 0. Outside one, or on any failure, it prints nothing and
exits 1, and the launch keeps its args: a session gets the team's
instructions whole, never half of this overlay.

What the rewritten launch changes, for that session only:
  AGENTS.md  The team copy is excluded (claudeMdExcludes on the checkout's
             .claude/CLAUDE.md, whose one line imports it) and a filtered copy
             is given with --append-system-prompt-file: without the
             transcript-sharing section and the Bench tracking paragraph, with
             a short note on how this operator uses Bench. A heading or
             paragraph that no longer matches stays in, and the miss is logged
             to ~/.local/state/claude-planlab-overlay.log.
  skills     Every skill in the checkout's .claude/skills outside KEEP is
             user-invocable-only (hidden from the model, still a / command).
             A KEEP skill gets no override, so it stays as its own frontmatter
             and the checkout's settings.local.json have it (pl-close hides
             itself from the model by design; a launch --settings would
             outrank both). A name the operator's own skills also use is left
             alone, since overrides are keyed by name.
  --settings Claude Code applies only the last --settings, so one given to
             the launch (--fast's, or typed) is merged into this file, its
             keys winning; a launch whose --settings cannot be read keeps its
             args.

Why launch arguments and not a hook or a settings file (verified on Claude
Code 2.1.319): hook additionalContext over 10,000 characters reaches the
model only as a file path; CLAUDE.md files are read before SessionStart hooks
run; --setting-sources without project also drops the project's skills and
its nested CLAUDE.md files; skillOverrides take exact names, so a fixed list
goes stale as the team adds skills.

The Bench reminders the team's hooks give are switched off separately, by
PLANLAB_BENCH_REMINDERS=off in the user settings' env, which every launch
gets; this overlay never decides what those hooks say.
"""

import hashlib
import json
import os
import re
import sys
import tempfile
import time
from pathlib import Path

# Kept visible: Loopy work, deploys, the PR workflow, and the tooling hint's skill.
KEEP = re.compile(
    r"pl-loopy-.+|pl-deploy-.+|pl-commit|pl-tidy|pl-merge-develop|pl-squash-migrations|pl-pr"
    r"|pl-handle-code-review|pl-local-bugbot-cycle|pl-bugbot|pl-qa|pl-land|pl-close|pl-update-cli"
)
DROP_SECTIONS = ("Optional session transcript sharing",)
DROP_PARAGRAPHS = ("Track substantive coding work in Bench",)
NOTE = """## Bench, for this operator

I manage Bench cards and transcript sharing myself. Before changing code for
substantive work, check Bench read-only for the same work: `bench tasks
current`, then `bench tasks search <two or three words>`. When someone else
holds it, tell me who before going on. Create, start or comment on a card,
claim a Bench name, or share a transcript only when I ask. A card I started or
named for this work stays current through the PR and merge steps of
`.agents/skills/pl-bench-tasks/SKILL.md` that the PR skills run."""
# Flags that set the system prompt or the settings sources: with one of them the overlay stands aside.
CONFLICTS = ("--append-system-prompt", "--append-system-prompt-file", "--system-prompt",
             "--system-prompt-file", "--setting-sources")
CACHE_TTL_SECONDS = 14 * 24 * 3600


class Refusal(Exception):
    """This launch keeps its args."""


def checkout(start):
    """The PlanLab checkout holding start: the nearest .claude/CLAUDE.md, when it is the one-line import of
    AGENTS.md beside the team's Bench skill."""
    for directory in (start, *start.parents):
        entry = directory / ".claude" / "CLAUDE.md"
        if entry.is_file():
            is_planlab = (entry.read_text().strip() == "@../AGENTS.md" and (directory / "AGENTS.md").is_file()
                          and (directory / ".agents" / "skills" / "pl-bench-tasks").is_dir())
            return directory if is_planlab else None
    return None


def filtered(text):
    """AGENTS.md without the dropped section and paragraph, and the patterns that matched nothing."""
    misses = []
    for heading in DROP_SECTIONS:
        text, n = re.subn(r"^## " + re.escape(heading) + r"\n.*?(?=^## |\Z)", "", text, flags=re.M | re.S)
        misses += [] if n else [heading]
    for opening in DROP_PARAGRAPHS:
        text, n = re.subn(r"^" + re.escape(opening) + r".*?(?:\n\n|\Z)", "", text, flags=re.M | re.S)
        misses += [] if n else [opening]
    return text, misses


def own_skill_names():
    roots = {Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude") / "skills",
             Path.home() / ".claude" / "skills"}
    return {entry.name for root in roots if root.is_dir() for entry in root.iterdir()}


def skill_overrides(root):
    skills = root / ".claude" / "skills"
    names = {entry.name for entry in skills.iterdir() if (entry / "SKILL.md").is_file()} if skills.is_dir() else set()
    mine = own_skill_names()
    return {name: "user-invocable-only" for name in sorted(names - mine) if not KEEP.fullmatch(name)}


def given_settings(value):
    """A --settings value: inline JSON, or the path of a JSON file."""
    try:
        settings = json.loads(value) if value.lstrip().startswith("{") else json.loads(Path(value).read_text())
    except (OSError, ValueError) as error:
        raise Refusal(f"unreadable --settings: {error}")
    if not isinstance(settings, dict):
        raise Refusal("--settings is not an object")
    return settings


def split_args(args):
    """(the --settings values given, the args without them), reading flags only before a `--`."""
    given, rest, i = [], [], 0
    while i < len(args):
        arg = args[i]
        if arg == "--":
            rest += args[i:]
            break
        if arg.split("=", 1)[0] in CONFLICTS:
            raise Refusal(f"{arg.split('=', 1)[0]} given")
        if arg == "--settings":
            if i + 1 >= len(args):
                raise Refusal("--settings without a value")
            given.append(args[i + 1])
            i += 2
            continue
        if arg.startswith("--settings="):
            given.append(arg[len("--settings="):])
        else:
            rest.append(arg)
        i += 1
    return given, rest


def merged(base, settings):
    """base with settings on top: their keys win, except that exclusion lists add up and overrides merge."""
    result = dict(base)
    for key, value in settings.items():
        if key == "claudeMdExcludes" and isinstance(value, list):
            result[key] = result.get(key, []) + value
        elif key == "skillOverrides" and isinstance(value, dict):
            result[key] = {**result.get(key, {}), **value}
        else:
            result[key] = value
    return result


def cached(directory, stem, suffix, text):
    """text in a file named for its content, so concurrent launches with different settings never share one."""
    path = directory / f"{stem}-{hashlib.sha256(text.encode()).hexdigest()[:16]}{suffix}"
    if not path.is_file() or path.read_text() != text:
        handle, temporary = tempfile.mkstemp(dir=directory, prefix=".tmp-")
        with os.fdopen(handle, "w") as stream:
            stream.write(text)
        os.replace(temporary, path)
    os.utime(path)
    return path


def prune(cache):
    cutoff = time.time() - CACHE_TTL_SECONDS
    for old in cache.glob("*/*"):
        try:
            if old.lstat().st_mtime < cutoff:
                old.unlink()
        except OSError:
            pass


def log_misses(root, misses):
    log = Path.home() / ".local" / "state" / "claude-planlab-overlay.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    with log.open("a") as stream:
        stream.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {root}: no match for {misses}; the text stays in\n")


def overlay(args, cwd):
    root = checkout(cwd)
    if root is None:
        raise Refusal("not a PlanLab checkout")
    given, rest = split_args(args)
    # The checkout as the shell names it too, when a symlink makes that differ from the resolved path.
    logical = checkout(Path(os.environ["PWD"])) if os.environ.get("PWD", "").startswith("/") else None
    entries = sorted({str(found / ".claude" / "CLAUDE.md") for found in (root, logical) if found})
    settings = {"claudeMdExcludes": entries, "skillOverrides": skill_overrides(root)}
    for value in given:
        settings = merged(settings, given_settings(value))
    agents = root / "AGENTS.md"
    text, misses = filtered(agents.read_text())
    if misses:
        log_misses(root, misses)
    prompt = (f"Contents of {agents} (project instructions, checked into the codebase). This operator's "
              "launcher loads them here, without the sections on Bench task tracking and transcript sharing, "
              f"and adds their own Bench note at the end:\n\n{text.strip()}\n\n{NOTE}\n")
    cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "claude-planlab-overlay"
    directory = cache / hashlib.sha256(str(root).encode()).hexdigest()[:16]
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    prune(cache)
    return ["--settings", str(cached(directory, "settings", ".json", json.dumps(settings, indent=1))),
            "--append-system-prompt-file", str(cached(directory, "AGENTS", ".md", prompt)), *rest]


def main():
    try:
        args = overlay(sys.argv[1:], Path(os.getcwd()).resolve())
    except (Refusal, OSError, ValueError, UnicodeDecodeError):
        return 1
    sys.stdout.write("".join(arg + "\0" for arg in args))
    return 0


if __name__ == "__main__":
    sys.exit(main())
