#!/usr/bin/env zsh
# git-warm — keep git status fast in the clones ~/.gitconfig registers for
# background maintenance (maintenance.repo), in every worktree they have:
# where a worktree's untracked cache has gone stale, run the one git status
# that rewrites it.
#
# The cache lives in the worktree's index, and only a command holding the
# index lock rewrites it. twin and gwt read without the lock, so a worktree no
# one runs a plain git status in keeps a cache that a changed exclude file
# (.git/info/exclude, which tools append to, or ~/.config/git/ignore) has
# invalidated, and each later status walks the whole tree again. launchd runs
# this at load, hourly, and when either exclude file changes
# (com.qiushi.git-warm).
#
# Each worktree is read first without the lock. Only one whose read walked
# directories the cache should have answered is rewritten, and never one that
# git has locked (one being created), that has no index, or whose index lock
# is already held. A rewrite holds the lock for one status, so a commit started
# in that same moment finds it taken and fails; that happens only where the
# cache was stale.
#
# Usage: git-warm [-n]    -n: report what would be rewritten, rewrite nothing
# Prints a line per worktree rewritten (or that would be), and a line per
# worktree it could not read or repair. Exit 0.
emulate -L zsh
set -u
export PATH=/usr/bin:/bin:/opt/homebrew/bin
zmodload zsh/datetime

dry=0
[[ ${1:-} == -n ]] && dry=1

# A read the cache answered opens almost no directory; a stale one opens
# thousands (planlab: ~5,000). lstat counts say nothing: without fsmonitor
# every status lstats every tracked file, and a rewrite cannot change that.
max_opendir=100

# probe prints how many directories a read of the worktree opened, taking no
# lock: "none" when the index holds no untracked cache, "failed" when git could
# not read the worktree.
probe() {
  local out opendir
  out=$(GIT_OPTIONAL_LOCKS=0 GIT_TRACE2_PERF=1 git -C $1 status --porcelain 2>&1 >/dev/null) || {
    print -r -- failed
    return
  }
  opendir=${${(M)${(f)out}:#*opendir:*}##*opendir:}
  print -r -- ${${opendir%% *}:-none}
}

# stale is true of a probe the cache did not answer.
stale() {
  [[ $1 == (none|failed) ]] || (( $1 > max_opendir ))
}

for repo in ${(f)"$(git config --global --type=path --get-all maintenance.repo 2>/dev/null)"}; do
  [[ -d $repo ]] || continue
  # One record per worktree: its path, then "locked" or "prunable" when git
  # says so.
  local -a wts=()
  local wt="" flag=""
  for line in ${(f)"$(git -C $repo worktree list --porcelain)"} "worktree "; do
    case $line in
      worktree\ *)
        [[ -n $wt && -z $flag ]] && wts+=$wt
        wt=${line#worktree }; flag="" ;;
      locked*|prunable*) flag=skip ;;
    esac
  done
  for wt in $wts; do
    [[ -d $wt ]] || continue
    index=$(git -C $wt rev-parse --path-format=absolute --git-path index 2>/dev/null) || continue
    [[ -f $index && ! -e $index.lock ]] || continue
    opendir=$(probe $wt)
    if [[ $opendir == failed ]]; then
      print -r -- "$(date '+%F %T') could not read ${wt/#$HOME/~}"
      continue
    fi
    stale $opendir || continue
    if (( dry )); then
      print -r -- "would rewrite ${wt/#$HOME/~}: opendir $opendir"
      continue
    fi
    [[ -e $index.lock ]] && continue
    start=$EPOCHREALTIME
    git -C $wt status --porcelain >/dev/null 2>&1
    after=$(probe $wt)
    # A status that lost the lock race, or failed, exits without rewriting
    # anything, so only the read after it says whether the cache was repaired.
    verb=rewrote
    stale $after && verb="failed to rewrite"
    printf '%s %s %s: opendir %s -> opendir %s (%.1fs)\n' \
      "$(date '+%F %T')" $verb "${wt/#$HOME/~}" $opendir $after $(( EPOCHREALTIME - start ))
  done
done
exit 0
