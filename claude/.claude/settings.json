{
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_AFK_TIMEOUT_MS": "2147483647",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/steps:~/.claude/mods/quota:~/.claude/mods/worktree"
  },
  "permissions": {
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "SendMessage",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList"
    ],
    "defaultMode": "auto"
  },
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "artifact-capabilities": "off",
    "artifact-components": "off",
    "artifact-dashboard": "off",
    "artifact-data-table": "off",
    "artifact-design": "on",
    "artifact-diagramming": "on",
    "artifact-explainer": "off",
    "artifact-pr-review": "off",
    "artifact-report": "off",
    "batch": "off",
    "claude-api": "off",
    "claude-code-docs": "off",
    "claude-in-chrome": "off",
    "code-review": "off",
    "commit": "off",
    "commit-push-pr": "user-invocable-only",
    "cowork-plugin": "off",
    "dataviz": "user-invocable-only",
    "debug": "off",
    "design": "off",
    "design-sync": "off",
    "doc": "off",
    "doctor": "user-invocable-only",
    "explain-usage": "off",
    "fewer-permission-prompts": "off",
    "init": "user-invocable-only",
    "insights": "user-invocable-only",
    "keybindings-help": "off",
    "loop": "off",
    "memory-types": "off",
    "plan-artifact": "off",
    "pr": "off",
    "prototype": "user-invocable-only",
    "run": "off",
    "run-skill-generator": "off",
    "schedule": "off",
    "security-review": "user-invocable-only",
    "setup-claude": "off",
    "simplify": "off",
    "statusline": "user-invocable-only",
    "team-onboarding": "user-invocable-only",
    "update-config": "off",
    "verify": "off",
    "whiteboard": "off",
    "workflow-authoring": "off",
    "workshop": "user-invocable-only",
    "make-interfaces-feel-better": "user-invocable-only",
    "vitest": "user-invocable-only",
    "vercel-react-best-practices": "user-invocable-only",
    "typesafe-ai": "user-invocable-only",
    "test-audit": "user-invocable-only"
  },
  "disableBundledSkills": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-dangerous-git.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.config/tmux/scripts/tmux-agent-status.sh clear claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.config/tmux/scripts/tmux-agent-status.sh activate claude"
          }
        ]
      }
    ]
  },
  "disableRemoteControl": false,
  "disableWorkflows": true,
  "disableArtifact": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/commands/statusline-command.sh"
  },
  "enabledPlugins": {
    "feature-dev@claude-code-plugins": true,
    "code-review@claude-code-plugins": true,
    "typescript-lsp@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": false,
    "codex@openai-codex": false,
    "impeccable@impeccable": false,
    "posthog@posthog": false
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "posthog": {
      "source": {
        "source": "github",
        "repo": "PostHog/ai-plugin"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "autoCompactWindow": 833000,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "vim",
  "verbose": true,
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true
}
