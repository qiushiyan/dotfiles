#!/usr/bin/env python3
"""Check the staged docs of a change against documentation-standards.md
§ Before you commit a doc change, and show how much each doc grew.

usage: doc-check [LIVE_PATHSPEC ...]

Run from inside the repository after staging the docs the change touched
(git add -- <paths>). LIVE_PATHSPEC names the project's live docs, each as its
own argument; the default is docs/**/*.md, CLAUDE.md and AGENTS.md. Every hit
is a candidate, not a verdict: the standard's "What a hit means" says which
ones stand. Exit 0 after a report, 2 when nothing is staged or git fails."""

import re
import subprocess
import sys
from pathlib import Path

DEFAULT_LIVE = [":(glob)docs/**/*.md", "CLAUDE.md", "AGENTS.md"]
# The patterns are the standard's check block; keep the two in step.
CHECKS = [
    ("cardinal", re.compile(r"\b(two|three|four|five|six|seven) [a-z]+")),
    ("changelog", re.compile(r"no longer|previously|used to|formerly|before this|was replaced|is now")),
    ("pr-or-date", re.compile(r"#[0-9]{3,}\b|\b(since|as of|on) 20[0-9]{2}-|\(20[0-9]{2}-[0-9]{2}-[0-9]{2}\)")),
    ("table", re.compile(r"^\s*\|?\s*:?-+:?\s*(\|\s*:?-*:?\s*)+\|?\s*$")),
    ("post-merge", re.compile(r"merged [^.]{0,24} as `?[0-9a-f]{7,}|serving (on|from|since) |to be filled|at (the )?(merge|closeout)", re.I)),
]
OWED = re.compile(r"read owed", re.I)
OWED_MARKER = re.compile(r"\*\*Closing read owed\*\* \(#([0-9]+|PR|N)")
PROPOSAL = re.compile(r"(specs|plans|proposals|issues|records|research|adr)/[^ )`]*\.md")
SECTION_REF = re.compile(r"`([^`]+\.md)` § ([^`\n]+)")


def git(*args):
    r = subprocess.run(["git", *args], capture_output=True, text=True)
    if r.returncode:
        sys.exit(f"doc-check: git {' '.join(args)} failed: {r.stderr.strip()}")
    return r.stdout


def added_lines(paths):
    """(path, line number, text) for every line the staged diff adds."""
    out, path, line = [], None, 0
    for raw in git("diff", "--cached", "-U0", "--", *paths).splitlines():
        if raw.startswith("+++ "):
            path = raw[6:] if raw.startswith("+++ b/") else None
        elif raw.startswith("@@"):
            line = int(re.search(r"\+(\d+)", raw).group(1))
        elif raw.startswith("+") and path:
            out.append((path, line, raw[1:]))
            line += 1
    return out


def words(rev_path):
    """Word count of a file at a revision; 0 when it does not exist there."""
    r = subprocess.run(["git", "show", rev_path], capture_output=True, text=True)
    return len(r.stdout.split()) if r.returncode == 0 else 0


def heading_exists(root, doc, cited, text):
    """Whether some heading of the cited doc begins the text after `§`, ending
    at a word boundary; None when the cited file is not in this repository."""
    for base in (root, (root / doc).parent):
        target = base / cited
        if target.is_file():
            headings = [m.group(1).strip() for m in re.finditer(r"^#+\s+(.+)$", target.read_text(), re.M)]
            return any(text == h or (text.startswith(h) and not text[len(h)].isalnum())
                       for h in headings)
    return None


def main():
    live = sys.argv[1:] or DEFAULT_LIVE
    root = Path(git("rev-parse", "--show-toplevel").strip())
    staged = [p for p in git("diff", "--cached", "--name-only", "--", "*.md").split() if p]
    if not staged:
        print("doc-check: no staged Markdown. Stage the docs this change touched "
              "(git add -- <paths>), then run doc-check again.", file=sys.stderr)
        return 2
    live_set = set(git("ls-files", "--", *live).split()) | set(
        git("diff", "--cached", "--name-only", "--diff-filter=A", "--", *live).split())

    # Words, not lines: a rewrapped paragraph changes every line and no words.
    print("growth in words (HEAD -> staged):")
    total = 0
    for path in staged:
        before, after = words("HEAD:" + path), words(":" + path)
        total += after - before
        note = "   (grew: say why in the report)" if after > before else ""
        print(f"  {path}: {before} -> {after} ({after - before:+d}){note}")
    print(f"  total {total:+d}")

    hits = []
    for path, n, text in added_lines(staged):
        for name, pattern in CHECKS:
            if pattern.search(text):
                hits.append((name, path, n, text))
        if OWED.search(text) and not OWED_MARKER.search(text):
            hits.append(("owed-marker", path, n, text))
        if path in live_set and PROPOSAL.search(text):
            hits.append(("proposal-ref", path, n, text))
        for cited, after in SECTION_REF.findall(text):
            if heading_exists(root, path, cited, after.strip()) is False:
                shown = " ".join(after.split()[:6])
                hits.append(("broken-§", path, n, f"`{cited}` § {shown}… matches no heading there"))
    print(f"\nchecks ({len(hits)} candidate{'s' if len(hits) != 1 else ''}):")
    for name, path, n, text in hits:
        print(f"  {name}: {path}:{n}: {text.strip()[:160]}")
    if not hits:
        print("  none")
    return 0


if __name__ == "__main__":
    sys.exit(main())
