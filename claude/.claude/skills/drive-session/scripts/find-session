#!/usr/bin/env bash
# find-session [DIR]
# List the Rex blocks in this Rex session that run a Claude Code session: its
# window number (the tab the user counts by, `-` when detached), block id,
# state, session id (what `claude-steps show` takes), working directory and
# title. With DIR, only the sessions
# working in DIR or below it. A session's title is its own summary, so a
# worktree path is the surer way to find the one the user named.
set -u
want=""
if [ -n "${1:-}" ]; then
  want=$(cd "$1" 2>/dev/null && pwd -P) || { echo "no such directory: $1" >&2; exit 2; }
fi
found=0
windows=$(rex block ls 2>/dev/null | awk 'NR > 1 { print $2, $1 }')   # block suffix → window number
for id in $(rex block ls -q); do
  st=$(rex block call -b "$id" program_status 2>/dev/null) || continue
  rec=$(jq -c '.records[]? | select(.id=="claude")' <<<"$st")
  [ -n "$rec" ] || continue
  pid=$(jq -r '.owner.pid // empty' <<<"$rec")
  cwd=$(lsof -a -p "${pid:-0}" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')
  # The session's config dir is the primary's or one account's; its
  # sessions/ registry maps the pid to the session id.
  sid=$(cat "$HOME/.claude/sessions/$pid.json" "$HOME"/.claude-accounts/*/sessions/"$pid".json 2>/dev/null | jq -r '.sessionId // empty' | head -1)
  [ -z "$want" ] || case "$cwd/" in "$want"/*) ;; *) continue ;; esac
  title=$(rex block call -b "$id" title 2>/dev/null | jq -r '.title // ""')
  win=$(awk -v b="${id: -6}" '$1 == b { print $2 }' <<<"$windows")
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "${win:--}" "${id: -6}" "$(jq -r .state <<<"$rec")" "${sid:--}" "$cwd" "$title"
  found=1
done
[ "$found" = 1 ] || { echo "no Claude session${want:+ working in $want}" >&2; exit 1; }
