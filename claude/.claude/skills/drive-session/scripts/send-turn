#!/usr/bin/env bash
# send-turn BLOCK 'one short line'
# send-turn BLOCK --file PATH
# Type a prompt into the Claude Code session in Rex block BLOCK, submit it,
# and confirm from the session's transcript that it arrived whole: typing
# now and then loses a prompt's first characters, most often right after an
# interrupt, and the screen shows only the tail of a long input.
#
# Only a short single line is typed. Rex types in 1024-byte chunks and Claude
# Code keeps only what follows the last full one, silently; from about 1000
# bytes it also wraps typing as pasted content. So a longer prompt, or one of
# several lines, is written to a file, and --file sends "Read PATH and do what
# it asks." in its place.
#
# A slash command is compared as typed ("/review astra"). /compact records
# itself only once compaction ends, so it is given ten minutes, not one.
#
# Exit 0: arrived as sent, or queued whole while the session is busy (it takes
# a queued prompt mid-turn). 1: something else arrived (printed). 3: nothing in
# the transcript in time. 2: usage, or no session in BLOCK.
set -u
here=$(cd "$(dirname "$0")" && pwd)
block=${1:?usage: send-turn BLOCK TEXT | send-turn BLOCK --file PATH}
if [ "${2:-}" = --file ]; then
  [ -f "${3:-}" ] || { echo "no file: ${3:-}" >&2; exit 2; }
  text="Read $(cd "$(dirname "$3")" && pwd)/$(basename "$3") and do what it asks."
else
  text=${2:?usage: send-turn BLOCK TEXT | send-turn BLOCK --file PATH}
  if [ "$(printf '%s' "$text" | wc -l)" -gt 0 ] || [ "$(printf '%s' "$text" | wc -c)" -gt 500 ]; then
    echo "more than one short line: write it to a file and send it with --file" >&2
    exit 2
  fi
fi

before=$("$here/read-turn" "$block" --user --json 2>/dev/null | jq -r .id)
"$here/read-turn" "$block" --path >/dev/null || exit 2
rex send -b "$block" "$text" && sleep 1 && rex send-key -b "$block" enter || exit 2

polls=30
case "$text" in /compact*) polls=300 ;; esac
for _ in $(seq "$polls"); do
  sleep 2
  now=$("$here/read-turn" "$block" --user --json 2>/dev/null) || continue
  [ "$(jq -r .id <<<"$now")" = "$before" ] && continue
  got=$(jq -r .text <<<"$now")
  how=arrived
  [ "$(jq -r .queued <<<"$now")" = true ] && how="queued (the session takes it mid-turn)"
  if [ "$got" = "$text" ]; then
    echo "$how: $text"
    exit 0
  fi
  echo "$how differently:"
  echo "$got"
  [ "$how" = arrived ] && cat <<EOF
the session is working on it; take it back:
  rex send-key -b $block ctrl+c    # once, while it works; a second press quits Claude Code
  rex send-key -b $block ctrl+u    # repeat until the input box is empty, if the text came back into it
  send-turn $block --file <brief>  # then send it again
EOF
  exit 1
done
echo "nothing in the transcript after $((polls * 2)) s; read-turn $block --user shows what it last received"
exit 3
