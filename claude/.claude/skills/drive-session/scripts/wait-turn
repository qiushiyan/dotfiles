#!/usr/bin/env bash
# wait-turn BLOCK [QUIET_SECS] [BG_SECS]
# Wait until the Claude Code session in Rex block BLOCK has ended its turn and
# stayed that way QUIET_SECS (default 60): its Rex status is `done` with no
# background shell job left, or `blocked` on a permission prompt or a held
# message. A turn that ends while its background jobs run usually resumes when
# they finish, but it may also have ended on a question; so after BG_SECS
# (default 600) quiet it returns anyway, with a `background jobs:` line, for
# the caller to read the reply and decide. Then print the status record, the session's
# transcript path and the bottom of its screen. Exit 2 if the block has no
# Claude session.
set -u
block=${1:?usage: wait-turn BLOCK [QUIET_SECS] [BG_SECS]} quiet=${2:-60} bgcap=${3:-600}
last="" since=$(date +%s)
while true; do
  rec=$(rex block call -b "$block" program_status 2>/dev/null | jq -c '.records[]? | select(.id=="claude")')
  [ -n "$rec" ] || { echo "no Claude session in block $block"; exit 2; }
  key=$(jq -r '.state + " " + .updated_at' <<<"$rec")
  [ "$key" = "$last" ] || { last=$key since=$(date +%s); }
  state=$(jq -r .state <<<"$rec") owner=$(jq -r '.owner.pid // empty' <<<"$rec")
  # A turn that started a background Bash job reports done while the job runs;
  # Claude Code runs each Bash call as a child shell sourcing its snapshot.
  bg=0
  kids=$(pgrep -P "${owner:-0}" | paste -sd, -)
  [ -n "$kids" ] && bg=$(ps -o command= -p "$kids" | grep -c shell-snapshots)
  still=$(( $(date +%s) - since ))
  if { [ "$state" = blocked ] || { [ "$state" = done ] && [ "$bg" -eq 0 ]; }; } && [ "$still" -ge "$quiet" ] ||
     { [ "$state" = done ] && [ "$still" -ge "$bgcap" ]; }; then
    echo "status: $rec"
    [ "$bg" -gt 0 ] && echo "background jobs: $bg (the turn ended while they run)"
    echo "transcript: $("$(dirname "$0")/read-turn" "$block" --path)"
    echo "--- screen ---"
    rex capture -b "$block" --trim --unwrap | tail -40
    exit 0
  fi
  sleep 15
done
