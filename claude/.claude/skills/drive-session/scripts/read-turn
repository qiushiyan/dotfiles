#!/usr/bin/env python3
"""read-turn BLOCK [--last | --pending | --user | --path] [--json]

Read the Claude Code session in Rex block BLOCK from its transcript, which
holds what the screen cuts off:

  --last     its last reply to the user (default)
  --pending  the tool call it is waiting on, in full: what a permission
             prompt asks to run
  --user     the newest prompt it received, as it arrived; "(queued) " leads
             one typed while it was busy that it has not taken yet
  --path     the transcript's path
  --json     print {"id", "text", "queued"}, the id naming the transcript entry

Exit 2 when the block has no Claude session or its transcript is not found.
"""
import glob
import json
import os
import subprocess
import sys


def fail(msg):
    print(msg, file=sys.stderr)
    sys.exit(2)


def transcript(block):
    status = subprocess.run(["rex", "block", "call", "-b", block, "program_status"],
                            capture_output=True, text=True).stdout
    try:
        rec = next(r for r in json.loads(status).get("records", []) if r.get("id") == "claude")
        pid = rec["owner"]["pid"]
    except (ValueError, StopIteration, KeyError):
        fail(f"no Claude session in block {block}")
    home = os.path.expanduser("~")
    # The session's config dir is the primary's or one account's; its sessions/
    # registry maps the pid to the session id.
    for reg in [f"{home}/.claude/sessions/{pid}.json", *glob.glob(f"{home}/.claude-accounts/*/sessions/{pid}.json")]:
        if os.path.exists(reg):
            sid = json.load(open(reg))["sessionId"]
            found = glob.glob(f"{os.path.dirname(os.path.dirname(reg))}/projects/*/{sid}.jsonl")
            if found:
                return found[0]
    fail(f"no transcript found for the session in block {block} (pid {pid})")


def entries(path):
    for line in open(path):
        try:
            yield json.loads(line)
        except ValueError:
            continue


def texts(e, kind):
    content = (e.get("message") or {}).get("content")
    if isinstance(content, str):
        return [content] if kind == "text" else []
    return [b for b in content or [] if b.get("type") == kind]


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    path = transcript(sys.argv[1])
    flags = sys.argv[2:]
    as_json = "--json" in flags
    mode = next((f for f in flags if f != "--json"), "--last")
    if mode == "--path":
        print(path)
        return
    found, found_id, queued, pending = None, None, False, {}
    for e in entries(path):
        if e.get("type") == "assistant":
            t = [b["text"] for b in texts(e, "text") if b.get("text", "").strip()]
            if t and mode == "--last":
                found, found_id = "\n".join(t), e.get("uuid")
            for c in texts(e, "tool_use"):
                pending[c["id"]] = (c, e.get("uuid"))
        elif e.get("type") == "user":
            for r in texts(e, "tool_result"):
                pending.pop(r.get("tool_use_id"), None)
            # A typed prompt is origin "human"; task notifications and other
            # harness messages arrive with the user role too.
            human = (e.get("origin") or {}).get("kind", "human") == "human"
            t = [x if isinstance(x, str) else x.get("text", "") for x in texts(e, "text")]
            if mode == "--user" and human and t and not e.get("isMeta"):
                found, found_id, queued = "\n".join(t), e.get("uuid"), False
        elif mode == "--user" and e.get("type") == "queue-operation" and e.get("operation") == "enqueue":
            # A prompt typed while the session works is queued at once, then
            # taken mid-turn as a queued_command attachment.
            found, found_id, queued = e.get("content", ""), "queued:" + e.get("timestamp", ""), True
        elif mode == "--user" and e.get("type") == "attachment":
            a = e.get("attachment") or {}
            if a.get("type") == "queued_command" and (a.get("origin") or {}).get("kind", "human") == "human":
                found, found_id, queued = a.get("prompt", ""), e.get("uuid"), False
    if mode == "--pending" and pending:
        c, found_id = list(pending.values())[-1]
        found = f"{c['name']}:\n" + (c["input"].get("command") or json.dumps(c["input"], indent=1))
    if found is None:
        fail(f"nothing for {mode} in {path}")
    if as_json:
        print(json.dumps({"id": found_id, "text": found, "queued": queued}))
    else:
        print(("(queued) " if queued else "") + found)


if __name__ == "__main__":
    main()
