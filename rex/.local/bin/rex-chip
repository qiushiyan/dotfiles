#!/usr/bin/env bash
# rex-chip SESSION BLOCK: the Claude context chip as a strip, a two-row pane
# under a Claude pane, in colour: the Rex lab's counterpart of the tmux border
# chip (tmux/.config/tmux/scripts/context-chip.md), since Rex draws pane
# headers in plain text. prefix C (the chip_strip action) opens and closes it.
#
#   account  model:effort  5h 7d  model-weekly  ✳ context
#
# The statusline writes the values (claude/.claude/commands/statusline-rex.sh)
# to ~/.cache/claude-ctx/rex/<block>.chip; this redraws when that file
# changes or the pane resizes, sheds fields by width as the border does, and
# closes when the Claude pane is gone. It runs on the host of its session, so
# it reads the cache of the machine Claude runs on.
set -u
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export LC_ALL=${LC_ALL:-en_US.UTF-8} # ${#…} counts characters, for alignment
session=${1:?usage: rex-chip SESSION BLOCK}
block=${2:?usage: rex-chip SESSION BLOCK}
file="$HOME/.cache/claude-ctx/rex/${block//:/_}.chip"
stamp=$(mktemp -t rex-chip)
trap 'rm -f "$stamp"; printf "\e[?25h"' EXIT

e=$'\e['
# ANSI slots, so the strip follows the terminal theme; the tmux chip's roles:
# calm quotas in a quiet accent, account and model muted, context from green.
MUTED="${e}90m" CALM="${e}36m" YELLOW="${e}33m" RED="${e}31m" GREEN="${e}32m" BOLD="${e}1m" OFF="${e}0m"

level() { # VALUE CALM_COLOUR -> the colour its value earns
  if [ "$1" -ge 90 ] 2>/dev/null; then printf '%s' "$RED"
  elif [ "$1" -ge 50 ] 2>/dev/null; then printf '%s' "$YELLOW"
  else printf '%s' "$2"; fi
}

render() {
  local cols ctx account model effort five seven wk wkmodel line="" plain=""
  cols=$(stty size </dev/tty 2>/dev/null); cols=${cols#* }; [ -n "$cols" ] || cols=80
  printf '\e[?25l\e[H\e[2J'
  if [ ! -r "$file" ]; then
    printf ' %swaiting for Claude to draw its statusline…%s' "$MUTED" "$OFF"
    return
  fi
  read -r ctx account model effort five seven wk wkmodel < "$file"
  add() { # TEXT COLOUR
    line+="  $2$1$OFF"; plain+="  $1"
  }
  [ "$account" != - ] && [ "$cols" -ge 40 ] && add "$account" "$MUTED"
  if [ "$model" != - ] && [ "$cols" -ge 55 ]; then
    add "$model$([ "$effort" != - ] && printf ':%s' "$effort")" "$MUTED"
  fi
  if [ "$cols" -ge 80 ]; then
    [ "$five" != - ] && add "5h:$five" "$(level "$five" "$CALM")"
    [ "$seven" != - ] && add "7d:$seven" "$(level "$seven" "$CALM")"
  fi
  [ "$wk" != - ] && [ "$wkmodel" != - ] && [ "$cols" -ge 140 ] && add "$wkmodel:$wk" "$(level "$wk" "$MUTED")"
  add "✳ $ctx%" "$BOLD$(level "$ctx" "$GREEN")"
  # Right-aligned, as on the border.
  local pad=$((cols - ${#plain} - 1))
  [ "$pad" -gt 0 ] || pad=0
  printf '%*s%s' "$pad" '' "$line"
}

# Two rows tall. The app evens out a new split ("balance splits on creation")
# after the action that made it returns, so the strip sizes itself once that
# has happened: the share of the pair's height that leaves it two rows.
fit() {
  local a b
  a=$(rex block call -s "$session" -b "$block" size 2>/dev/null | jq -r '.rows // empty')
  b=$(stty size </dev/tty 2>/dev/null); b=${b% *}
  [ -n "$a" ] && [ -n "$b" ] || return
  [ "$b" -le 3 ] && return
  rex api call session.resize_pane "$(jq -nc --arg s "$session" --arg a "$block" --arg b "$REX_BLOCK" \
    --argjson r "$(awk "BEGIN { t = $a + $b; r = (t - 2) / t; if (r > 0.97) r = 0.97; print r }")" \
    '{session_id: $s, direction: "vertical", before_block_id: $a, after_block_id: $b, ratio: $r}')" >/dev/null 2>&1
}
( sleep 1; fit ) &

trap render WINCH
render; : > "$stamp"
tick=0
while :; do
  sleep 0.5
  if [ -r "$file" ] && [ "$file" -nt "$stamp" ]; then render; : > "$stamp"; fi
  tick=$((tick + 1))
  # Every ~10 s: is the Claude pane still there? rex probes a terminal on
  # stderr, whose reply would arrive here as input.
  if [ $((tick % 20)) -eq 0 ]; then
    rex api call session.list_blocks "{\"session_id\":\"$session\"}" 2>/dev/null \
      | grep -q "\"$block\"" || exit 0
  fi
done
