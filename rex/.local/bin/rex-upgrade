#!/usr/bin/env python3
"""rex-upgrade: move this machine's Rex, app and server, to a newer build and
bring every session back as it was. docs/rex-restart.md is the runbook.

  rex-upgrade check               the feed's newest build beside the app and the server
  rex-upgrade stage [BUILD]       download the newest build (or BUILD) from the app's
                                  own feed, verify its signature, and stage it
  rex-upgrade start [--now]       run the restart as a one-off launchd job, outside Rex
  rex-upgrade start --dry-run     what that job would do now, step by step, touching
                                  nothing (the snapshot is real; the restore is a dry run)
  rex-upgrade snapshot [DIR]      record every session, tab and pane (reads only)
  rex-upgrade restore [--go] SNAPSHOT
                                  rebuild a snapshot on a restarted server; a dry run
                                  without --go
  rex-upgrade job DIR [--now] [--report SID]
                                  INTERNAL: what start runs

The job waits until no Claude Code in Rex is busy and no drive step or job
runs (--now: it does not wait), snapshots, stops drive's wakes, quits the
app, stops the server, swaps in the staged app if there is one, opens the app
so it starts the new server from its own copy, restores every session, arms
drive's wakes again, and asks the Claude Code that ran `start` (when it ran in
this Rex) to report. With nothing staged it only restarts, as after Sparkle
updated the app. Each run keeps its snapshot, screens, logs and the app it
replaced in ~/.local/state/rex-lab/upgrades/<time>/.

The image is verified by its code signature, Gatekeeper and the installed
app's team, not by Sparkle's EdDSA key, which needs a library the system
Python lacks.

REX_UPGRADE_APP, REX_UPGRADE_FEED and REX_UPGRADE_LABEL replace the app's
path, its feed and the launchd job's label, and REX_UPGRADE_TICK the seconds
between checks, for tests.
"""
import glob, json, os, platform, plistlib, re, shlex, shutil, subprocess, sys, tempfile, time
import xml.etree.ElementTree as ET

HOME = os.path.expanduser("~")
APP = os.environ.get("REX_UPGRADE_APP") or "/Applications/Rex Beta.app"
STATE = f"{HOME}/.local/state/rex-lab/upgrades"
STAGE = f"{STATE}/stage"
VERSIONS = f"{HOME}/Library/Application Support/com.superlogical.rex/RexServer/Versions"
LABEL = os.environ.get("REX_UPGRADE_LABEL") or "com.qiushi.rex-upgrade"
TICK = float(os.environ.get("REX_UPGRADE_TICK") or 5)  # seconds between checks; tests shorten it
PATH = f"{HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
SPARKLE = "{http://www.andymatuschak.org/xml-namespaces/sparkle}"
CONTINUE = ("Rex restarted and ended this session mid-turn; any background jobs or agents it was "
            "waiting on are gone. Continue from where you stopped.")
# A pane's REX_SERVER outranks HOME, so every call reaches this HOME's server.
ENV = {k: v for k, v in os.environ.items() if k not in ("REX_SESSION", "REX_BLOCK", "REX_SERVER")}
ENV["PATH"] = PATH + ":" + ENV.get("PATH", "")  # an ssh command's PATH lacks ~/.local/bin
ENV.setdefault("HEADROOM_PRIMARY_NAME", "qiushi.yann")  # drive's --account primary needs it; .zshrc exports it


def run(*a, timeout=120):
    try:
        r = subprocess.run(list(a), capture_output=True, text=True, env=ENV, timeout=timeout)
        return r.returncode, r.stdout, r.stderr
    except subprocess.TimeoutExpired:
        return 124, "", "timed out"
    except FileNotFoundError as e:
        return 127, "", str(e)


def rex(*a, timeout=120):
    return run("rex", "--autostart=false", *a, timeout=timeout)


def rexj(*a):
    code, out, _ = rex(*a)
    try:
        return json.loads(out) if code == 0 and out.strip() else None
    except ValueError:
        return None


def rexs(*a):
    """A read that must succeed: a snapshot built on a failed read is one a restore cannot trust."""
    code, out, err = rex(*a)
    try:
        return json.loads(out)
    except ValueError:
        raise SystemExit(f"rex {' '.join(a)} failed ({code}): {(err or out).strip()[:300]}")


def log(msg):
    print(time.strftime("%H:%M:%S ") + msg, flush=True)


def remove(path):
    """Delete a tree this tool made: only under STATE, never a path read empty."""
    real = os.path.realpath(path) if path else ""
    if not real or not real.startswith(os.path.realpath(STATE) + "/"):
        sys.exit(f"refusing to delete {path!r}: not under {STATE}")
    shutil.rmtree(real, ignore_errors=True)


# The app, the feed and the server ----------------------------------------------------

def info(app):
    try:
        with open(f"{app}/Contents/Info.plist", "rb") as f:
            return plistlib.load(f)
    except (OSError, plistlib.InvalidFileException):
        return {}


def feed():
    """The feed's builds, newest first."""
    url = os.environ.get("REX_UPGRADE_FEED") or info(APP).get("SUFeedURL")
    if not url:
        sys.exit(f"no feed: {APP} names no SUFeedURL")
    code, body, err = run("curl", "-sfL", "--max-time", "30", url)
    if code:
        sys.exit(f"cannot read the feed {url}: {err.strip() or code}")
    out = []
    for item in ET.fromstring(body).iter("item"):
        enc = item.find("enclosure")
        build = item.findtext(f"{SPARKLE}version") or (enc.get(f"{SPARKLE}version") if enc is not None else None)
        if not build or enc is None:
            continue
        m = re.search(r"Rex (\d+\.\d+\.\d+-g[0-9a-f]+)", item.findtext("description") or "")
        out.append({"build": int(build), "version": m.group(1) if m else None, "url": enc.get("url"),
                    "length": int(enc.get("length") or 0), "min_os": item.findtext(f"{SPARKLE}minimumSystemVersion"),
                    "date": item.findtext("pubDate")})
    return sorted(out, key=lambda b: -b["build"])


def server_status():
    code, out, _ = rex("server", "status")
    if code != 0:
        return None
    st = dict(l.split(": ", 1) for l in out.splitlines() if ": " in l and not l.startswith(" "))
    st["text"] = out
    return st


def cli_version():
    _, out, _ = run("rex", "version")
    m = re.match(r"rex (\S+)", out)
    return m.group(1) if m else None


def team(app):
    _, _, err = run("codesign", "-dv", app)
    m = re.search(r"TeamIdentifier=(\S+)", err)
    return m.group(1) if m else None


def staged_build():
    return info(f"{STAGE}/{os.path.basename(APP)}").get("CFBundleVersion")


def cmd_check():
    builds = feed()
    newest = builds[0] if builds else None
    have = info(APP).get("CFBundleVersion")
    st, cli, staged = server_status(), cli_version(), staged_build()
    print(f"feed:    {newest['build']} (server {newest['version']}), {newest['date']}" if newest else "feed:    empty")
    print(f"app:     {have or 'not installed'} ({APP}), CLI {cli}")
    print(f"server:  {st['version']} (pid {st['pid']}, started {st.get('started')})" if st else "server:  not running")
    print(f"staged:  {staged or 'nothing'}")
    if staged:
        print("next:    rex-upgrade start")
    elif newest and have and newest["build"] > int(have):
        print("next:    rex-upgrade stage, then rex-upgrade start")
    elif st and cli and st["version"] != cli:
        print("next:    the server runs another build than the app; rex-upgrade start restarts it")
    else:
        print("up to date")


def cmd_stage(build=None):
    builds = feed()
    pick = next((b for b in builds if build is None or b["build"] == int(build)), None)
    if not pick:
        sys.exit(f"the feed has no build {build}" if build else "the feed lists no build")
    have = info(APP).get("CFBundleVersion")
    if build is None and have and int(have) >= pick["build"]:
        print(f"the app is {have}, the feed's newest {pick['build']}: nothing to stage")
        return
    if pick["min_os"]:
        mine = tuple(int(x) for x in platform.mac_ver()[0].split("."))
        if mine < tuple(int(x) for x in pick["min_os"].split(".")):
            sys.exit(f"build {pick['build']} needs macOS {pick['min_os']}")
    os.makedirs(STATE, exist_ok=True)
    work = tempfile.mkdtemp(prefix="download-", dir=STATE)
    try:
        dmg, mnt = f"{work}/rex.dmg", f"{work}/mnt"
        print(f"downloading build {pick['build']} from {pick['url']}")
        code, _, err = run("curl", "-sfL", "-o", dmg, pick["url"], timeout=1800)
        if code:
            sys.exit(f"download failed: {err.strip() or code}")
        if pick["length"] and os.path.getsize(dmg) != pick["length"]:
            sys.exit(f"downloaded {os.path.getsize(dmg)} bytes, the feed says {pick['length']}")
        os.mkdir(mnt)
        code, _, err = run("hdiutil", "attach", "-nobrowse", "-readonly", "-mountpoint", mnt, dmg, timeout=300)
        if code:
            sys.exit(f"cannot mount the image: {err.strip()}")
        try:
            apps = glob.glob(f"{mnt}/*.app")
            if len(apps) != 1:
                sys.exit(f"the image holds {len(apps)} apps, not one")
            new = f"{work}/{os.path.basename(APP)}"
            code, _, err = run("ditto", apps[0], new, timeout=600)
            if code:
                sys.exit(f"cannot copy the app out of the image: {err.strip()}")
        finally:
            run("hdiutil", "detach", "-quiet", mnt, timeout=120)
        if str(info(new).get("CFBundleVersion")) != str(pick["build"]):
            sys.exit(f"the image holds build {info(new).get('CFBundleVersion')}, not {pick['build']}")
        code, _, err = run("codesign", "--verify", "--deep", "--strict", new, timeout=600)
        if code:
            sys.exit(f"its code signature does not verify: {err.strip()}")
        code, _, err = run("spctl", "-a", "-t", "exec", new)
        if code:
            sys.exit(f"Gatekeeper refuses it: {err.strip()}")
        want = team(APP) if os.path.isdir(APP) else None
        if want and team(new) != want:
            sys.exit(f"it is signed by team {team(new)}, the installed app by {want}")
        if os.path.isdir(STAGE):
            remove(STAGE)
        os.makedirs(STAGE)
        os.rename(new, f"{STAGE}/{os.path.basename(APP)}")
        print(f"staged build {pick['build']} (server {pick['version']}), signed by team {team(f'{STAGE}/{os.path.basename(APP)}')}")
        print("next: rex-upgrade start")
    finally:
        remove(work)


# Snapshot ----------------------------------------------------------------------------

def registry(pid):
    """Claude Code's sessions/<pid>.json and the config dir it sits in."""
    for f in glob.glob(f"{HOME}/.claude-accounts/*/sessions/{pid}.json") + glob.glob(f"{HOME}/.claude/sessions/{pid}.json"):
        try:
            return os.path.dirname(os.path.dirname(f)), json.load(open(f))
        except ValueError:
            return None, None
    return None, None


def account_names(config_dir):
    """(launcher suffix for x-<name>, drive --account value)."""
    if config_dir == f"{HOME}/.claude":
        return ENV["HEADROOM_PRIMARY_NAME"], "primary"
    local = os.path.basename(config_dir).split("@")[0]
    return local, local


def extra_args(argv):
    """Claude flags worth keeping on the relaunch; x adds the bypass itself."""
    out, skip = [], False
    for t in argv.split()[1:]:
        if skip:
            skip = False
        elif t in ("--resume", "-r", "--session-id"):
            skip = True
        elif t not in ("--dangerously-skip-permissions", "--continue", "-c"):
            out.append(t)
    return out


def live_batches():
    """Every live drive batch, as (driver, batch); driver is None for a driver of no name."""
    code, out, err = run("drive", "status", "--json")
    if code == 0:
        try:
            st = json.loads(out)
        except ValueError:
            raise SystemExit(f"drive status printed no JSON: {out[:200]}")
        b = st.get("batch")
        return [(None, b["name"] if isinstance(b, dict) else b)] if b else []
    found = re.findall(r"(?:a driver of no name|(\S+)) drives (\S+)", err)
    if not found and "no batch" not in err and "drives no batch" not in err:
        raise SystemExit(f"drive status failed: {err.strip()[:300]}")
    return [(d or None, b) for d, b in found]


def drive_status(batch):
    code, out, err = run("drive", "--batch", batch, "status", "--json")
    if code != 0:
        raise SystemExit(f"drive --batch {batch} status failed: {err.strip()[:300]}")
    return json.loads(out)


def drive_batches():
    """Every live batch's sessions, keyed by Rex block id's last six."""
    by_block, batches = {}, {}
    for driver, bname in live_batches():
        st = drive_status(bname)
        batches[bname] = {"driver": driver, "open_asks": st.get("open_asks")}
        for s in st.get("sessions", []):
            if s.get("block"):
                watch = s.get("watch") or ""
                by_block[s["block"]] = {"driver": driver, "batch": bname, "label": s["label"], "sid": s.get("sid"),
                                        "account": s.get("account"), "state": s.get("state"), "jobs": bool(s.get("jobs")),
                                        "parked": watch[len("parked: "):] if watch.startswith("parked: ") else None}
    return by_block, batches


def jobs_of(bid, batches):
    """Whether the Claude Code in block BID runs background jobs, as drive reads it."""
    code, out, _ = run("drive", *(["--batch", next(iter(batches))] if batches else []), "read", bid[-6:], "--json")
    try:
        return bool(json.loads(out).get("jobs")) if code == 0 else False
    except ValueError:
        return False


def describe(d, sl, bid, label, flavor, driven, batches):
    proc = rexs("block", "call", "-s", sl, "--block", bid, "process")
    fg, child = proc.get("foreground") or {}, proc.get("child") or {}
    argv = run("ps", "-o", "args=", "-p", str(fg["pid"]))[1].strip() if fg.get("pid") else ""
    b = {"block": bid, "short": bid[-6:], "label": label, "flavor": flavor, "cwd": fg.get("cwd") or child.get("cwd"),
         "fg": fg.get("name"), "argv": argv, "kind": "shell"}
    cfg, reg = registry(fg["pid"]) if fg.get("pid") else (None, None)
    if reg:
        launcher, account = account_names(cfg)
        b["kind"] = "claude"
        b["claude"] = {"sid": reg["sessionId"], "dir": reg.get("cwd") or b["cwd"], "launcher": f"x-{launcher}",
                       "account": account, "extra": extra_args(argv), "busy": reg.get("status") == "busy"}
    elif fg.get("name") not in (None, "zsh", "-zsh", "bash", "login"):
        b["kind"] = "other"
    if bid[-6:] in driven:
        b["driven"] = driven[bid[-6:]]
    if reg:
        b["claude"]["jobs"] = b["driven"]["jobs"] if b.get("driven") else jobs_of(bid, batches)
    screen = rex("capture", "-s", sl, "-b", bid)[1]
    open(f"{d}/screens/{sl}-{label}-{bid[-6:]}.txt", "w").write(screen)
    return b


def tree_of(node, blocks, describe_leaf):
    """Rex's layout tree with each leaf's block described: {"split": {...}} or {"pane": index}."""
    if "split" in node:
        sp = node["split"]
        return {"split": {"direction": sp["direction"], "ratio": sp.get("ratio", 0.5),
                          "before": tree_of(sp["before"], blocks, describe_leaf),
                          "after": tree_of(sp["after"], blocks, describe_leaf)}}
    blocks.append(describe_leaf(node["block_id"]))
    return {"pane": len(blocks) - 1}


def snapshot(d):
    """Record every session, tab and layout in d/snapshot.json, each screen in d/screens/.
    Any read that fails stops it: a partial snapshot is one a restore cannot trust."""
    st = server_status()
    if not st:
        sys.exit("no Rex server runs")
    os.makedirs(f"{d}/screens", exist_ok=True)
    driven, batches = drive_batches()
    auto = {}
    names = f"{HOME}/.local/state/rex-lab/tab-names"
    if os.path.exists(names):
        auto = dict(l.rstrip("\n").split("\t", 1) for l in open(names) if "\t" in l)
    snap = {"taken_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "server": st, "batches": batches, "sessions": []}
    for s in rexs("ls", "--json")["sessions"]:
        sl = s["label"]
        wins = rexs("window", "ls", "-s", sl, "--json")["windows"]
        info_of = {b["block_id"]: b for b in rexs("block", "ls", "-s", sl, "--json")["blocks"]}
        wins.sort(key=lambda w: int(m.group()) if (m := re.match(r"\d+", w.get("label") or "")) else 1 << 30)
        sess = {"label": sl, "windows": []}
        for w in wins:  # in tab order
            tiled = [l for l in w["layers"] if l["kind"] == "tiled" and l.get("layout")]
            if not tiled:
                continue
            name = re.sub(r"^\d+\s*", "", w.get("label") or "")
            # A name rexd gave follows the pane, so only one you gave is set again.
            win = {"label": w.get("label"), "name": name, "yours": auto.get(w["window_id"]) != name, "blocks": []}
            win["tree"] = tree_of(tiled[0]["layout"], win["blocks"], lambda bid: describe(
                d, sl, bid, (info_of.get(bid) or {}).get("label"), (info_of.get(bid) or {}).get("flavor"), driven, batches))
            sess["windows"].append(win)
        snap["sessions"].append(sess)
    json.dump(snap, open(f"{d}/snapshot.json", "w"), indent=1)
    print(f"snapshot {snap['taken_at']} -> {d}/snapshot.json")
    for s in snap["sessions"]:
        print(f"\n{s['label']}")
        for w in s["windows"]:
            for i, b in enumerate(w["blocks"]):
                tab = f"  {w['label'] or '':<12}" if i == 0 else " " * 14
                c, dv = b.get("claude") or {}, b.get("driven")
                what = f"claude {c['sid'][:8]} {c['launcher']} {' '.join(c['extra'])}".rstrip() if c else (b["argv"] or b["fg"] or "")
                tag = ("BUSY" if c.get("busy") else "idle") + (" +jobs" if c.get("jobs") else "") if c else ""
                if dv:
                    tag = f"drive {dv['driver'] or dv['batch']}:{dv['label']} {dv['state']}" + (" parked" if dv["parked"] else "")
                print(f"{tab} {b['label'] or '':<8} {what:<55} {tag:<28} {b['cwd']}")
    return snap


# Restore -----------------------------------------------------------------------------

SHELL = "com.superlogical.terminal.shell"


def interrupted(b):
    """Whether a pane's Claude Code lost work to the restart: mid-turn, or running background jobs."""
    c, dv = b.get("claude") or {}, b.get("driven")
    if dv:
        return dv["state"] == "working" or dv.get("jobs")
    return c.get("busy") or c.get("jobs")


class Restore:
    """Rebuild a snapshot window by window: Rex creates each window from its saved layout in
    one call; drive reopens each driven pane, and the panes beside it are split in around it.
    restore.json beside the snapshot records each window as it comes back, so a second run
    rebuilds only what the first did not."""

    def __init__(self, go, manifest):
        self.go, self.problems, self.manifest_path = go, [], manifest
        self.done = json.load(open(manifest)) if go and os.path.exists(manifest) else {}
        self.running = live_sids() if go else set()  # conversations already running elsewhere

    def sh(self, args, check=True):
        print("  $ " + shlex.join(args))
        if not self.go:
            return ""
        code, out, err = run(*args, timeout=300)
        if code != 0:
            msg = f"{shlex.join(args)} -> exit {code}: {(err or out).strip()[:600]}"
            if check:
                self.problems.append(msg)
            print("    ! " + msg)
            return None
        return out.strip()

    def api(self, session, method, args):
        out = self.sh(["rex", "--autostart=false", "api", "call", *(["-s", session] if session else []),
                       method, json.dumps(args)])
        return json.loads(out) if out else None

    def drive(self, batch, *a):
        return self.sh(["drive", "--batch", batch, *a])

    def block(self, b):
        """The layout node that starts pane B again."""
        opts = {"cwd": b["cwd"] or HOME}
        if b["cwd"] and not os.path.isdir(b["cwd"]):
            self.problems.append(f"pane {b['label'] or b['short']} ran in {b['cwd']}, which is gone: opened in ~"
                                 + (", where its conversation does not resume" if b["kind"] == "claude" else ""))
        if b["kind"] == "claude" and b["claude"]["sid"] in self.running:
            self.problems.append(f"pane {b['label'] or b['short']}: conversation {b['claude']['sid'][:8]} runs elsewhere "
                                 f"already, so a shell opened in its place")
        elif b["kind"] == "claude":
            c = b["claude"]
            cmd = " ".join([c["launcher"], *map(shlex.quote, c["extra"]), "--resume", c["sid"]])
            # login=False: without it Rex wraps the command in login(1), which then stands in
            # front of Claude Code, and the next snapshot would not find its conversation.
            opts.update(shell="none", login=False, command=["/bin/zsh", "-lic", cmd + "; exec zsh -l"])
        elif b["kind"] == "other":
            self.problems.append(f"pane {b['label'] or b['short']} ran {b['argv']!r}: opened as a shell, start it by hand")
        node = {"flavor": b.get("flavor") or SHELL, "options": opts}
        if b["label"]:
            node["label"] = b["label"]
        return {"block": node}

    def layout(self, tree, blocks, skip=()):
        """The API layout for TREE, leaving out the panes in SKIP; None when nothing is left."""
        if "pane" in tree:
            return None if tree["pane"] in skip else self.block(blocks[tree["pane"]])
        sp = tree["split"]
        before, after = self.layout(sp["before"], blocks, skip), self.layout(sp["after"], blocks, skip)
        if before is None or after is None:
            return before or after
        return {"split": {"direction": sp["direction"], "ratio": sp["ratio"], "before": before, "after": after}}

    @staticmethod
    def order(tree, skip=()):
        """The panes of TREE in layout order, as the API returns their new blocks."""
        if "pane" in tree:
            return [] if tree["pane"] in skip else [tree["pane"]]
        return Restore.order(tree["split"]["before"], skip) + Restore.order(tree["split"]["after"], skip)

    def live_windows(self, session):
        if not self.go:
            return set()
        v = rexj("window", "ls", "-s", session, "--json") or {"windows": []}
        return {w["window_id"] for w in v["windows"]}

    def new_window(self, sl, live, w, layout):
        """Create a window from LAYOUT; its id and block ids."""
        name = {"window_label": w["name"]} if w["yours"] and w["name"] else {}
        if sl not in live:
            r = self.api(None, "session.create", {"label": sl, "initial_windows": [{"layout": layout, **name}]})
            live.add(sl)
            if not self.go:
                return "<window>", ["<block>"] * 64
            win = (r or {}).get("initial_windows", [{}])[0] if r else {}
            return win.get("window_id"), win.get("block_ids") or []
        r = self.api(sl, "session.new_window", {"layout": layout, "focus": False, **name})
        if not self.go:
            return "<window>", ["<block>"] * 64
        return (r or {}).get("window_id"), (r or {}).get("block_ids") or []

    def reopen(self, sl, b):
        """drive reopens a driven pane; the new block's id, found by its short id in the session."""
        dv, c = b["driven"], b["claude"]
        out = self.drive(dv["batch"], "open", dv["label"], "--dir", c["dir"], "--resume", c["sid"], "--account", c["account"])
        if out is None:
            return None
        if not self.go:
            return "<block>"
        read = self.sh(["drive", "--batch", dv["batch"], "read", dv["label"], "--json"])
        short = json.loads(read).get("session") if read else None
        for blk in (rexj("block", "ls", "-s", sl, "--json") or {"blocks": []})["blocks"]:
            if short and blk["block_id"].endswith(short):
                return blk["block_id"]
        self.problems.append(f"{sl}: drive reopened {dv['label']} but its block was not found to place the panes beside it")
        return None

    def around(self, sl, anchor, tree, blocks, target, skip):
        """Split the panes of TREE in around the block ANCHOR, which holds pane TARGET: top down,
        each level's other side beside the anchor, so the anchor's space shrinks to its own."""
        made = {}
        node = tree
        while "split" in node:
            sp = node["split"]
            mine = "before" if target in self.order(sp["before"]) else "after"
            other = sp["after" if mine == "before" else "before"]
            layout = self.layout(other, blocks, skip)
            if layout is not None:
                r = self.api(sl, "session.new_split", {"anchor_id": anchor, "direction": sp["direction"],
                                                       "side": "after" if mine == "before" else "before",
                                                       "ratio": sp["ratio"], "layout": layout})
                ids = (r or {}).get("block_ids") or (["<block>"] * 64 if not self.go else [])
                made.update(zip(self.order(other, skip), ids))
            node = sp[mine]
        return made

    def window(self, sl, live, w, later, expect):
        blocks = w["blocks"]
        driven = [i for i, b in enumerate(blocks) if b.get("driven") and b.get("claude")]
        for i, b in enumerate(blocks):
            if b.get("driven") and not b.get("claude"):
                self.problems.append(f"{sl}: driven label {b['driven']['label']} ran no Claude Code; reopen it by hand")
        made = {}
        if not driven:
            wid, ids = self.new_window(sl, live, w, self.layout(w["tree"], blocks))
            made = dict(zip(self.order(w["tree"]), ids))
        else:
            first, rest = driven[0], driven[1:]
            if rest:
                self.problems.append(f"{sl}: tab {w['name']} held several driven labels; each came back in a tab of its own")
            anchor = self.reopen(sl, blocks[first])
            live.add(sl)  # drive starts the session under its label when none runs
            if anchor:
                made[first] = anchor
                made.update(self.around(sl, anchor, w["tree"], blocks, first, set(rest)))
                if w["yours"] and w["name"] and self.go:
                    wid = next((b.get("window_id") for b in (rexj("block", "ls", "-s", sl, "--json") or {"blocks": []})["blocks"]
                                if b["block_id"] == anchor), None)
                    if wid:
                        self.api(sl, "session.set_window_label", {"window_id": wid, "label": w["name"]})
            for i in rest:
                bid = self.reopen(sl, blocks[i])
                if bid:
                    made[i] = bid
            wid = None
        for i, bid in made.items():
            b = blocks[i]
            if b.get("claude") and b["claude"]["sid"] not in self.running:
                expect.append((sl, bid, b))
                if interrupted(b):
                    later.append((sl, bid, b))
        return wid, made

    def run(self, snap):
        live = {s["label"] for s in (rexj("ls", "--json") or {"sessions": []})["sessions"]} if self.go else set()
        later, expect = [], []
        for s in snap["sessions"]:
            sl = s["label"]
            print(f"\n== {sl}")
            windows = self.live_windows(sl) if sl in live else set()
            for n, w in enumerate(s["windows"]):
                key = f"{sl}#{n}"
                if key in self.done and (self.done[key] is None or self.done[key] in windows):
                    print(f"  tab {w['label']}: restored already")
                    continue
                wid, made = self.window(sl, live, w, later, expect)
                if self.go and made and len(made) == len(w["blocks"]):
                    self.done[key] = wid
                    json.dump(self.done, open(self.manifest_path, "w"), indent=1)
        print("\n== every conversation back")
        if self.go:
            missing = self.await_conversations(expect)
            later = [x for x in later if x[2]["claude"]["sid"] not in missing]
        print("\n== the interrupted sessions")
        for sl, bid, b in later:
            label = b["label"] or b["short"]
            if b.get("driven"):
                dv = b["driven"]
                v = self.view_of(dv["batch"], dv["label"])
                if v:
                    self.drive(dv["batch"], "send", v, CONTINUE)
            else:
                self.nudge(sl, bid, label)
        self.sh(["rexd"], check=False)
        print("\n== result")
        if self.problems:
            print("needs a look:")
            for p in self.problems:
                print("  - " + p)
        elif self.go:
            print("everything came back; check with: rex window ls -A, and drive status per batch")

    def await_conversations(self, expect):
        """Wait until every resumed conversation runs again; name each that does not."""
        want = {b["claude"]["sid"]: (sl, bid, b) for sl, bid, b in expect}
        end = time.time() + max(36 * TICK, 20)
        while want and time.time() < end:
            for sid in live_sids() & set(want):
                want.pop(sid)
            if want:
                time.sleep(TICK)
        for sid, (sl, bid, b) in want.items():
            c = b["claude"]
            self.problems.append(f"{sl}/{b['label'] or b['short']} ({bid[-6:]}): conversation {sid[:8]} did not come back; "
                                 f"in that pane: cd {shlex.quote(c['dir'] or '~')} && {c['launcher']} --resume {sid}")
        print(f"  {len(expect) - len(want)} of {len(expect)} running again")
        return set(want)

    def nudge(self, session, block, label):
        """Type the continue line into a resumed Claude Code nobody drives."""
        print(f"  continue -> {session}/{label} ({block[-6:]})")
        if not self.go:
            return
        pid = wait_ready(session, block)
        if not pid:
            self.problems.append(f"{session}/{label}: Claude did not come up idle within 2 min; send it 'continue' by hand")
            return
        if not send_line(session, block, pid, CONTINUE):
            self.problems.append(f"{session}/{label}: 'continue' did not start a turn; look at the pane")

    def view_of(self, batch, label):
        if not self.go:
            return f"{label}@<view>"
        out = self.drive(batch, "read", label, "--json")
        return json.loads(out)["view"] if out else None


def cmd_restore(path, go):
    snap = json.load(open(path))
    print(f"restoring the snapshot of {snap['taken_at']}" + ("" if go else "  (dry run: add --go to do it)"))
    if go:
        if os.environ.get("REX_BLOCK"):
            sys.exit("run this from outside Rex: a launchd job (rex-upgrade start), or ssh from the other machine")
        st = server_status()
        if not st:
            sys.exit("no Rex server runs; start it first")
        if st.get("instance") == snap["server"].get("instance"):
            sys.exit("this is still the server the snapshot was taken on; restart it first")
        if "running" in snap["server"].get("tailscale", "") and "running" not in st.get("tailscale", ""):
            sys.exit("the server runs without its tailnet address, so the other machine cannot reach it")
    r = Restore(go, os.path.join(os.path.dirname(os.path.abspath(path)), "restore.json"))
    r.run(snap)
    return 1 if r.problems and go else 0


# Claude Code in Rex ------------------------------------------------------------------

def rex_claudes():
    """(session, block, registry) for every Claude Code running in a Rex pane."""
    out = []
    for s in (rexj("ls", "--json") or {"sessions": []})["sessions"]:
        for b in (rexj("block", "ls", "-s", s["label"], "--json") or {"blocks": []})["blocks"]:
            p = rexj("block", "call", "-s", s["label"], "--block", b["block_id"], "process") or {}
            pid = (p.get("foreground") or {}).get("pid")
            reg = registry(pid)[1] if pid else None
            if reg:
                out.append((s["label"], b["block_id"], reg))
    return out


def live_sids():
    """Claude conversations already running somewhere, so none is resumed twice."""
    out = set()
    for f in glob.glob(f"{HOME}/.claude-accounts/*/sessions/*.json") + glob.glob(f"{HOME}/.claude/sessions/*.json"):
        try:
            d = json.load(open(f))
            os.kill(d["pid"], 0)
            out.add(d["sessionId"])
        except (OSError, ValueError, KeyError):
            pass
    return out


def reg_status(pid):
    return (registry(pid)[1] or {}).get("status")


def wait_ready(session, block, limit=None):
    end = time.time() + (limit or max(24 * TICK, 15))
    while time.time() < end:
        pid = ((rexj("block", "call", "-s", session, "--block", block, "process") or {}).get("foreground") or {}).get("pid")
        if pid and reg_status(pid) in ("idle", "waiting"):
            return pid
        time.sleep(2)
    return None


def send_line(session, block, pid, text):
    """Type TEXT and Enter into a Claude Code; True once it starts a turn."""
    rex("send", "-s", session, "-b", block, text)
    time.sleep(1)
    for _ in range(2):
        rex("send-key", "-s", session, "-b", block, "enter")
        for _ in range(10):
            time.sleep(1.5)
            if reg_status(pid) == "busy":
                return True
    return False


def caller_session():
    """The Claude Code session this command runs under, found up the process tree."""
    pid = os.getppid()
    for _ in range(12):
        if pid <= 1:
            return None
        reg = registry(pid)[1]
        if reg and reg.get("sessionId"):
            return reg["sessionId"]
        _, out, _ = run("ps", "-o", "ppid=", "-p", str(pid))
        pid = int(out.strip() or 0)
    return None


# The job -----------------------------------------------------------------------------

def noisy():
    """What keeps Rex from being quiet now; empty when quiet."""
    why = [f"{s}/{b[-6:]} busy" for s, b, reg in rex_claudes() if reg.get("status") == "busy"]
    try:
        for _, batch in live_batches():
            st = drive_status(batch)
            why += [f"{batch}:{x['label']} runs a job" for x in st.get("sessions", []) if x.get("jobs")]
            why += [f"{batch}: a step in flight" for _ in (st.get("in_flight") or [])[:1]]
    except SystemExit as e:
        why.append(str(e))
    return why


def wait_quiet():
    said, streak = 0, 0
    while True:
        why = noisy()
        streak = streak + 1 if not why else 0
        if streak >= 2:
            return
        if why and time.time() - said > 600:
            log("waiting for quiet: " + "; ".join(why[:12]))
            said = time.time()
        time.sleep(4 * TICK)


def mark_now(d, snap, report):
    """--now: a driven session with a background job gets the continue line too, since the job
    dies; the session that ran start is asked to report instead."""
    for s in snap["sessions"]:
        for w in s["windows"]:
            for b in w["blocks"]:
                c, dv = b.get("claude"), b.get("driven")
                if c and c["sid"] == report:
                    c["busy"] = c["jobs"] = False
                    if dv:
                        dv["state"], dv["jobs"] = "done", False
    json.dump(snap, open(f"{d}/snapshot.json", "w"), indent=1)


def stop_watches(d):
    """drive watch --stop-all; returns the watch --due commands it prints."""
    code, out, err = run("drive", "watch", "--stop-all")
    log(f"drive watch --stop-all -> {code}\n{out}{err}".rstrip())
    open(f"{d}/watch-due.txt", "w").write(out)
    if code != 0:
        return None
    return [l.strip() for l in out.splitlines() if l.strip().startswith("drive ") and "--due" in l]


def app_pids():
    exe = info(APP).get("CFBundleExecutable")
    if not exe:
        return []
    _, out, _ = run("pgrep", "-f", f"{APP}/Contents/MacOS/{exe}")
    return out.split()


def quit_app():
    for pid in app_pids():
        run("kill", "-TERM", pid)
    for _ in range(30):
        if not app_pids():
            return True
        time.sleep(1)
    return False


def swap_app(d):
    """Put the staged bundle in place of the app; the app it replaces moves to d/old/."""
    for prior in glob.glob(f"{STATE}/*/old"):
        if os.path.realpath(prior) != os.path.realpath(f"{d}/old"):
            remove(prior)  # one replaced app is kept, the last
    os.makedirs(f"{d}/old", exist_ok=True)
    os.rename(APP, f"{d}/old/{os.path.basename(APP)}")
    os.rename(f"{STAGE}/{os.path.basename(APP)}", APP)
    log(f"app swapped to build {info(APP).get('CFBundleVersion')}; the CLI is {cli_version()}")


def server_ok(expected, old):
    st = server_status()
    if not st:
        return False, "no server"
    _, env, _ = run("ps", "eww", "-o", "command=", "-p", st["pid"])
    bad = [t for t in env.split() if t.startswith(("NO_COLOR=", "FORCE_COLOR=", "TERM=dumb", "DRIVE_WATCH=", "SSH_CONNECTION="))]
    if bad:
        return False, f"server pid {st['pid']} carries {' '.join(bad)}"
    if expected and st.get("version") != expected:
        return False, f"server pid {st['pid']} runs {st.get('version')}, not {expected}"
    if "running" in old.get("tailscale", "") and "running" not in st.get("tailscale", ""):
        rex("server", "tailscale", "on")
        time.sleep(5)
        st = server_status() or {}
        if "running" not in st.get("tailscale", ""):
            return False, "the tailnet address is not up"
    return True, st["text"]


def start_flags(old):
    """The tailnet flags the old server ran with, for a start without the app."""
    m = re.match(r"running · ([^.\s]+)\.", old.get("tailscale", ""))
    return ["--tailscale", "--tailscale-hostname", m.group(1)] if m else []


def restart_server(old):
    """Stop the server and bring the new build up: the app starts it from its own copy, or
    this job does when the app does not. Three tries."""
    expected = bundle_version(APP) or cli_version()
    for attempt in range(1, 4):
        log(f"stopping the server (attempt {attempt})")
        rex("server", "stop")
        if info(APP).get("CFBundleExecutable"):
            run("open", APP)
            for _ in range(int(6 * TICK)):
                if server_status():
                    break
                time.sleep(1)
        if not server_status():
            ours = glob.glob(f"{VERSIONS}/{info(APP).get('CFBundleVersion')}/*/Contents/MacOS/rex")
            code, out, err = run(*(ours[:1] or ["rex"]), "server", "start", *start_flags(old), timeout=120)
            log(f"the app started no server; started one -> {code} {(out or err).strip()[:200]}")
        for _ in range(12):
            ok, why = server_ok(expected, old)
            if ok:
                log("server up and clean:\n" + why)
                return True
            time.sleep(TICK)
        log("server not right: " + why)
        quit_app()
    return False


def tell(report, d, outcome):
    """Ask the Claude Code that ran start to check the outcome and report it; True once it took the line."""
    end = time.time() + max(24 * TICK, 15)
    while time.time() < end:
        for s, b, reg in rex_claudes():
            if reg.get("sessionId") == report:
                pid = wait_ready(s, b)
                if pid and send_line(s, b, pid, (
                        f"rex-upgrade ran while this session was stopped, and resumed it: {outcome}. Read "
                        f"{d}/job.log and {d}/restore.log, check every session as "
                        f"{HOME}/dotfiles/docs/rex-restart.md § Checking after says, and report what you find.")):
                    log(f"asked the session that ran start ({s}/{b[-6:]}) to report")
                    return True
                log(f"the session that ran start ({s}/{b[-6:]}) did not take the report request")
                return False
        time.sleep(TICK)
    log("the session that ran start did not come back; nothing asked it to report")
    return False


def cmd_job(d, now, report):
    if not os.path.realpath(d).startswith(os.path.realpath(STATE) + "/"):
        sys.exit(f"refusing to run: {d} is not under this HOME's {STATE}, so this job would act on another server")
    staged = staged_build()
    log(("upgrade to build " + staged if staged else "server restart")
        + (" (--now: no wait for quiet)" if now else "; waiting until Rex is quiet"))
    while True:
        if not now:
            wait_quiet()
        log("taking the snapshot")
        try:
            snap = snapshot(d)
        except SystemExit as e:
            log(f"STOPPED before touching anything: the snapshot failed: {e}")
            return 1
        if now:
            mark_now(d, snap, report)
            break
        busy = [b["short"] for s in snap["sessions"] for w in s["windows"] for b in w["blocks"]
                if interrupted(b)]
        if not busy:
            break
        log(f"not quiet after all ({', '.join(busy)}); waiting again")
    due = stop_watches(d)
    if due is None:
        log("STOPPED before touching anything: drive could not stop the wakes, so its bots would race the restore")
        return 1

    def back_out(why):
        log(f"STOPPED: {why}; the server and the app are as they were")
        for cmd in due:
            run("/bin/zsh", "-c", cmd)
        run("open", APP) if info(APP).get("CFBundleExecutable") else None
        return 1

    if not quit_app():
        return back_out("the app did not quit within 30 s")
    if staged:
        log("stopping the old server")
        rex("server", "stop")
        if server_status():
            return back_out("the old server did not stop")
        swap_app(d)
    if not restart_server(snap["server"]):
        log(f"GAVE UP: the server is not right after three starts; nothing restored. Once it is: "
            f"rex-upgrade restore --go {d}/snapshot.json")
        return 1
    code, out, err = run(sys.executable, os.path.abspath(__file__), "restore", "--go", f"{d}/snapshot.json", timeout=1800)
    open(f"{d}/restore.log", "w").write(out + err)
    log(f"restore exit {code}; its output is in restore.log")
    rearmed = True
    for cmd in due:
        c, o, e = run("/bin/zsh", "-c", cmd)
        rearmed &= c == 0
        log(f"{cmd} -> {c} {(o + e).strip()[:300]}")
    outcome = ("every session came back" if code == 0 else "some sessions need a hand (restore.log, under needs a look)")
    if not rearmed:
        outcome += "; drive's wakes did not all arm again (job.log)"
    if report:
        tell(report, d, outcome)
    log(("done: " if code == 0 and rearmed else "done, with problems: ") + outcome)
    return 0 if code == 0 and rearmed else 1


def bundle_version(app):
    """The rex version of the CLI inside an app bundle."""
    clis = glob.glob(f"{app}/Contents/Helpers/*/Contents/MacOS/rex")
    _, out, _ = run(clis[0], "version") if clis else (1, "", "")
    m = re.match(r"rex (\S+)", out)
    return m.group(1) if m else None


def plan(d, now, report):
    """What the job would do, step by step, touching nothing: the snapshot is real, every
    other step is described, and the restore is its dry run."""
    staged = staged_build()
    why = noisy()
    print("\n1. quiet: " + ("quiet now" if not why else "waits for: " + "; ".join(why[:12]))
          + (" (--now: it would not wait)" if now else ""))
    print("\n2. snapshot")
    snap = snapshot(d)
    if now:
        mark_now(d, snap, report)
    for s in snap["sessions"]:  # the job waits until that session is idle, or asks it to report
        for b in (b for w in s["windows"] for b in w["blocks"] if report and (b.get("claude") or {}).get("sid") == report):
            b["claude"]["busy"] = b["claude"]["jobs"] = False
    print("\n3. drive watch --stop-all; live batches: "
          + (", ".join(f"{b} ({v['driver'] or 'a driver of no name'})" for b, v in snap["batches"].items()) or "none"))
    pids = app_pids()
    print(f"\n4. quit the app ({'pid ' + ' '.join(pids) if pids else 'not running'}), stop the server "
          f"(pid {snap['server'].get('pid')}, {snap['server'].get('version')})")
    if staged:
        print(f"   swap {APP}: build {info(APP).get('CFBundleVersion')} -> {staged}; the old one moves to {d}/old/")
    expected = bundle_version(f"{STAGE}/{os.path.basename(APP)}") if staged else (bundle_version(APP) or cli_version())
    print(f"   open the app to start build {expected}; if it starts none: rex server start "
          + " ".join(start_flags(snap["server"])))
    print("\n5. restore (its dry run):")
    Restore(False, f"{d}/restore.json").run(snap)
    ids = {b["claude"]["sid"] for s in snap["sessions"] for w in s["windows"] for b in w["blocks"] if b.get("claude")}
    print(f"\n   then: the watch --due lines step 3 prints; ask {report[:8] if report else 'no session'} to report"
          + ("" if not report or report in ids else " (it is not in this Rex, so nothing is asked)"))


def cmd_start(now, dry):
    uid = os.getuid()
    _, out, _ = run("launchctl", "print", f"gui/{uid}/{LABEL}")
    if "state = running" in out:
        sys.exit(f"a rex-upgrade job runs already: launchctl print gui/{uid}/{LABEL}")
    d = f"{STATE}/{time.strftime('%Y-%m-%d-%H%M%S')}"
    os.makedirs(d)
    report = caller_session()
    env = {"PATH": PATH, "HOME": HOME, **{k: ENV[k] for k in (
        "HEADROOM_PRIMARY_NAME", "REX_UPGRADE_APP", "REX_UPGRADE_FEED", "REX_UPGRADE_LABEL", "REX_UPGRADE_TICK",
        "DRIVE_STATE_DIR", "DRIVE_CONFIG_DIR") if k in ENV}}
    job = {"Label": LABEL, "RunAtLoad": True, "KeepAlive": False, "WorkingDirectory": d,
           "ProgramArguments": [sys.executable, os.path.abspath(__file__), "job", d]
                               + (["--now"] if now else []) + (["--report", report] if report else []),
           "StandardOutPath": f"{d}/job.log", "StandardErrorPath": f"{d}/job.log", "EnvironmentVariables": env}
    with open(f"{d}/job.plist", "wb") as f:
        plistlib.dump(job, f)
    staged = staged_build()
    print(f"{'upgrade to build ' + staged if staged else 'server restart'}"
          f"{', now' if now else ', once Rex is quiet'}; the session to report: {report or 'none'}")
    if dry:
        plan(d, now, report)
        print(f"\ndry run: nothing stopped or started; the job it would load is {d}/job.plist")
        return
    run("launchctl", "bootout", f"gui/{uid}/{LABEL}")  # a finished run's job stays loaded
    code, _, err = run("launchctl", "bootstrap", f"gui/{uid}", f"{d}/job.plist")
    if code:
        sys.exit(f"launchctl bootstrap failed: {err.strip()}")
    print(f"started; follow it with: tail -f {d}/job.log")


def main(argv):
    if argv[:1] in (["-h"], ["--help"], ["help"]):
        print(__doc__)
        return 0
    if not argv:
        print(__doc__, file=sys.stderr)
        return 2
    cmd, rest = argv[0], argv[1:]
    flags = {a for a in rest if a.startswith("--")}
    args = [a for a in rest if not a.startswith("--")]
    if cmd == "check":
        cmd_check()
    elif cmd == "stage":
        cmd_stage(args[0] if args else None)
    elif cmd == "start":
        cmd_start("--now" in flags, "--dry-run" in flags)
    elif cmd == "snapshot":
        snapshot(args[0] if args else f"{STATE}/{time.strftime('%Y-%m-%d-%H%M%S')}-snapshot")
    elif cmd == "restore" and args:
        return cmd_restore(args[0], "--go" in flags)
    elif cmd == "job" and args:
        report = rest[rest.index("--report") + 1] if "--report" in rest else None
        return cmd_job(args[0], "--now" in flags, report)
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]) or 0)
