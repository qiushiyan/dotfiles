<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.qiushi.gazette-night</string>

  <!-- 02:00, after the 01:30 mirror refresh: gazette's nightly run for
       PlanLab (served on the tailnet by com.qiushi.gazette-planlab-site),
       then for his own instance (gazette.qiushiyan.dev). Each drains its
       site's inbox, then runs the feeds, the editor, its evaluations, the
       edition and research PRs. ";" so a failed PlanLab night still runs
       qiushi's. Run records: ~/.local/share/gazette-planlab/runs and
       ~/.local/share/gazette/runs. ~/dev/gazette/docs/operations.md. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>/Users/qiushiyan/dev/gazette/bin/gazette --instance planlab night; /Users/qiushiyan/dev/gazette/bin/gazette --instance qiushi night</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>/tmp</string>

  <key>StandardOutPath</key>
  <string>/Users/qiushiyan/Library/Logs/gazette-night.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/qiushiyan/Library/Logs/gazette-night.log</string>
</dict>
</plist>
