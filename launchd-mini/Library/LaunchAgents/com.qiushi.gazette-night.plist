<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.qiushi.gazette-night</string>

  <!-- 02:00, after the 01:30 mirror refresh: gazette's nightly run for his
       own instance (gazette.qiushiyan.dev). It drains the site's inbox,
       then runs the feeds, the editor, up to three evaluations, the
       edition and research PRs. PlanLab's night joins ahead of it, as
       "gazette --instance planlab night; ", once gazette.planlab.ai serves.
       Run records: ~/.local/share/gazette/runs.
       ~/dev/gazette/docs/operations.md. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/qiushiyan/dev/gazette/bin/gazette</string>
    <string>--instance</string>
    <string>qiushi</string>
    <string>night</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>/tmp</string>

  <key>StandardOutPath</key>
  <string>/Users/qiushiyan/Library/Logs/gazette-night.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/qiushiyan/Library/Logs/gazette-night.log</string>
</dict>
</plist>
