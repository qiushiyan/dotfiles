# Included by ~/.gitconfig for the planlab clone and its linked worktrees.
#
# planlab's pre-push hook (.githooks/pre-push) is only the git-lfs upload.
# Everyday pushes skip it; push LFS assets with `command git push` or
# `git lfs push --all origin <branch>`. repo.pushArgs is read by every tool
# that pushes for you: the zsh git() wrapper (~/.config/zsh/git.zsh) and gopen.
[repo]
	pushArgs = --no-verify
